LAST_REQUEST_TIME = time.time()

class ZoteroHandler(http.server.BaseHTTPRequestHandler):
    def handle_one_request(self):
        global LAST_REQUEST_TIME
        LAST_REQUEST_TIME = time.time()
        return super().handle_one_request()

    def send_cors_headers(self, status=200, content_type="application/json"):
        self.send_response(status)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS, HEAD")
        self.send_header("Access-Control-Allow-Headers", "*")
        self.send_header("Access-Control-Expose-Headers", "X-Zotero-Version, X-Zotero-Connector-API-Version, Content-Type")
        self.send_header("Access-Control-Allow-Private-Network", "true")
        self.send_header("X-Zotero-Version", "7.0.0")
        self.send_header("X-Zotero-Connector-API-Version", "3")
        self.send_header("Content-Type", content_type)
        self.end_headers()

    def do_OPTIONS(self):
        self.send_cors_headers(200)

    def parse_multipart_or_form(self, raw_body):
        """Parseja multipart/form-data o application/x-www-form-urlencoded de forma directa i compatible amb LF/CRLF."""
        ctype = self.headers.get("Content-Type", "")
        fields = {}
        files = {}
        if "multipart/form-data" in ctype.lower():
            m_b = re.search(r'boundary=([^;\s]+)', ctype, re.I)
            if m_b:
                boundary_str = m_b.group(1).strip('"\'')
                boundary_bytes = ("--" + boundary_str).encode("utf-8")
                parts = raw_body.split(boundary_bytes)
                for part in parts[1:]:
                    if part.startswith(b"--") or len(part.strip()) == 0:
                        continue
                    # Eliminar salt de línia inicial després del boundary
                    if part.startswith(b"\r\n"):
                        part = part[2:]
                    elif part.startswith(b"\n"):
                        part = part[1:]
                    # Eliminar salt de línia final abans del següent boundary
                    if part.endswith(b"\r\n"):
                        part = part[:-2]
                    elif part.endswith(b"\n"):
                        part = part[:-1]

                    # Separar capçaleres del cos de la part (suporta \r\n\r\n i \n\n)
                    if b"\r\n\r\n" in part:
                        hdr_bytes, payload_bytes = part.split(b"\r\n\r\n", 1)
                    elif b"\n\n" in part:
                        hdr_bytes, payload_bytes = part.split(b"\n\n", 1)
                    else:
                        continue

                    hdr_text = hdr_bytes.decode("utf-8", errors="ignore")
                    m_name = re.search(r'name=["\']?([^"\';\r\n]+)["\']?', hdr_text, re.I)
                    if not m_name:
                        continue
                    name = m_name.group(1).strip()
                    fname_m = re.search(r'filename=["\']?([^"\'\r\n]*)["\']?', hdr_text, re.I)
                    m_ct = re.search(r'Content-Type:\s*([^\r\n;]+)', hdr_text, re.I)
                    part_ct = m_ct.group(1).strip() if m_ct else "application/octet-stream"

                    if fname_m is not None or b"<!DOCTYPE" in payload_bytes[:200] or b"<html" in payload_bytes[:200].lower() or payload_bytes.startswith(b"%PDF"):
                        files[name] = {
                            "filename": (fname_m.group(1).strip() if fname_m else "") or "upload.html",
                            "content_type": part_ct,
                            "bytes": payload_bytes
                        }
                    else:
                        fields[name] = payload_bytes.decode("utf-8", errors="ignore").strip()
        elif "application/x-www-form-urlencoded" in ctype.lower():
            qs = parse_qs(raw_body.decode("utf-8", errors="ignore"))
            for k, v in qs.items():
                if v:
                    fields[k] = v[0]
        return fields, files

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path == "/manifest.json":
            self.send_cors_headers(200, "application/manifest+json; charset=utf-8")
            self.wfile.write(MOBILE_PWA_MANIFEST.encode("utf-8"))
            return

        if parsed.path == "/sw.js":
            self.send_cors_headers(200, "application/javascript; charset=utf-8")
            self.wfile.write(b"self.addEventListener('fetch', function(event) {});")
            return

        if parsed.path in ("/", "/mobile", "/ingest", "/capture"):
            qs = parse_qs(parsed.query)
            shared_url = (qs.get("url") or qs.get("text") or [""])[0].strip()
            force_web = (qs.get("force_web") or [""])[0] in ("1", "true", "on")
            if shared_url:
                m_http = re.search(r'(https?://\S+)', shared_url)
                target_arg = m_http.group(1) if m_http else shared_url
                run_add_paper_async(target_arg, force_web=force_web)
                html_out = render_mobile_portal_html(f"✅ Processant en segon pla: <code>{target_arg}</code>")
            else:
                html_out = render_mobile_portal_html()
            self.send_cors_headers(200, "text/html; charset=utf-8")
            self.wfile.write(html_out.encode("utf-8"))
            return

        if "/connector/ping" in self.path:
            # Si un navegador sol·licita text/html directament
            accept = self.headers.get("Accept", "")
            if "text/html" in accept and "application/json" not in accept:
                self.send_cors_headers(200, "text/html; charset=utf-8")
                self.wfile.write(b"<!DOCTYPE html><html><body>Zotero is running</body></html>")
                return
            self.send_cors_headers(200, "application/json")
            resp = {
                "version": "7.0.0",
                "prefs": {
                    "downloadAssociatedFiles": True,
                    "reportActiveURL": True,
                    "automaticSnapshots": True
                }
            }
            self.wfile.write(json.dumps(resp).encode("utf-8"))
        else:
            self.send_cors_headers(200)
            self.wfile.write(b'{"version":"7.0.0"}')

    do_HEAD = do_GET

    def do_POST(self):
        content_len = int(self.headers.get("Content-Length", 0))
        raw_body = self.rfile.read(content_len)
        body = raw_body.decode("utf-8", errors="ignore")
        
        if "/connector/getSelectedCollection" in self.path:
            self.send_cors_headers(200)
            resp = {"libraryID": 1, "libraryName": "Biblioteca", "collection": None, "editable": True, "filesEditable": True}
            self.wfile.write(json.dumps(resp).encode("utf-8"))
            return

        if "/connector/ping" in self.path:
            self.send_cors_headers(200, "application/json")
            resp = {
                "version": "7.0.0",
                "prefs": {
                    "downloadAssociatedFiles": True,
                    "reportActiveURL": True,
                    "automaticSnapshots": True
                }
            }
            self.wfile.write(json.dumps(resp).encode("utf-8"))
            return

        if "/connector/saveItems" in self.path:
            self.send_cors_headers(201)
            self.wfile.write(b'{"success":true}')
            try:
                payload = json.loads(body)
                items = payload.get("data", {}).get("items", []) or payload.get("items", [])
                print(f"📥 Zotero Connector: rebuts {len(items)} element(s) per desar", file=sys.stderr)
                for it in items:
                    threading.Thread(target=process_zotero_item, args=(it,), daemon=True).start()
            except Exception as e:
                print(f"Error processant saveItems: {e}", file=sys.stderr)
            return

        if "/connector/saveSnapshot" in self.path:
            self.send_cors_headers(201)
            self.wfile.write(b'{"success":true,"id":1}')
            try:
                payload = json.loads(body) if body.strip() else {}
                url = payload.get("url") or payload.get("uri") or ""
                title = payload.get("title") or ""
                html = payload.get("html") or payload.get("content") or ""
                if not should_process_url(url):
                    print(f"ℹ️ Zotero Connector: ignora duplicat recent de saveSnapshot per a {url}", file=sys.stderr)
                    return
                print(f"📥 Zotero Connector: rebut saveSnapshot per a {url or title}", file=sys.stderr)
                item = {
                    "itemType": "webpage",
                    "title": title,
                    "url": url,
                    "html": html,
                    "creators": payload.get("creators", []),
                    "date": payload.get("date", "")
                }
                threading.Thread(target=process_zotero_item, args=(item,), daemon=True).start()
            except Exception as e:
                print(f"Error processant saveSnapshot: {e}", file=sys.stderr)
            return

        if "/connector/saveSingleFile" in self.path:
            self.send_cors_headers(201)
            self.wfile.write(b'{"success":true}')
            try:
                payload = json.loads(body) if body.strip() else {}
                url = payload.get("url") or payload.get("uri") or ""
                title = payload.get("title") or ""
                snapshot_content = payload.get("snapshotContent") or payload.get("html") or ""
                if url and snapshot_content:
                    if not should_process_url(url):
                        print(f"ℹ️ Zotero Connector: ignora duplicat recent de saveSingleFile per a {url}", file=sys.stderr)
                        return
                    print(f"📥 Zotero Connector: rebut saveSingleFile per a {url}", file=sys.stderr)
                    item = {
                        "itemType": "webpage",
                        "title": title,
                        "url": url,
                        "html": snapshot_content,
                        "date": payload.get("date", "")
                    }
                    threading.Thread(target=process_zotero_item, args=(item,), daemon=True).start()
            except Exception as e:
                print(f"Error processant saveSingleFile: {e}", file=sys.stderr)
            return

        if "/connector/saveStandaloneAttachment" in self.path:
            self.send_cors_headers(201)
            self.wfile.write(b'{"success":true}')
            try:
                meta_header = self.headers.get("X-Metadata", "{}")
                meta = json.loads(meta_header)
                url = meta.get("url", "")
                title = meta.get("title", "")
                content_type = meta.get("contentType", "")
                if raw_body.startswith(b"%PDF") or "pdf" in content_type.lower():
                    print(f"📥 Zotero Connector: rebut PDF independent per a {url or title}", file=sys.stderr)
                    tmp_pdf = Path(f"/tmp/standalone_{int(time.time()*1000)}.pdf")
                    tmp_pdf.write_bytes(raw_body)
                    item = {
                        "itemType": "journalArticle",
                        "title": title,
                        "url": f"file://{tmp_pdf.resolve()}",
                        "attachments": [{"url": f"file://{tmp_pdf.resolve()}", "mimeType": "application/pdf"}]
                    }
                    threading.Thread(target=process_zotero_item, args=(item,), daemon=True).start()
            except Exception as e:
                print(f"Error processant saveStandaloneAttachment: {e}", file=sys.stderr)
            return

        if "/singlefile" in self.path or "/ingest" in self.path or "/capture" in self.path:
            try:
                ctype = self.headers.get("Content-Type", "").lower()
                fields, files = self.parse_multipart_or_form(raw_body)

                # Comprovar si és un fitxer pujat (SingleFile HTML o PDF compartit des d'Android)
                file_obj = None
                for k, v in files.items():
                    if v.get("bytes"):
                        file_obj = v
                        break

                url_val = fields.get("url") or fields.get("uri") or ""
                title_val = fields.get("title") or ""
                text_val = fields.get("text") or ""
                force_web = fields.get("force_web", "") in ("1", "true", "on")

                # Cas 1: Fitxer PDF pujat des d'Android (menú Compartir, HTTP Shortcuts, o formulari)
                is_raw_pdf = raw_body.startswith(b"%PDF") or "application/pdf" in ctype
                if (file_obj and (file_obj["bytes"].startswith(b"%PDF") or file_obj["filename"].lower().endswith(".pdf"))) or is_raw_pdf:
                    pdf_bytes = file_obj["bytes"] if file_obj else raw_body
                    orig_fname = file_obj["filename"] if file_obj else (self.headers.get("X-Filename") or "shared_mobile.pdf")
                    tmp_pdf = Path(f"/tmp/mobile_shared_{int(time.time()*1000)}.pdf")
                    tmp_pdf.write_bytes(pdf_bytes)
                    guessed_title = title_val or extract_title_guess_from_pdf(tmp_pdf, fallback_filename=orig_fname)
                    print(f"📱 Android: rebut PDF compartit ({orig_fname}) -> títol deduït: {guessed_title}", file=sys.stderr)
                    item = {
                        "itemType": "journalArticle",
                        "title": guessed_title,
                        "url": f"file://{tmp_pdf.resolve()}",
                        "attachments": [{"url": f"file://{tmp_pdf.resolve()}", "mimeType": "application/pdf"}]
                    }
                    threading.Thread(target=process_zotero_item, args=(item,), daemon=True).start()
                    if "/singlefile" in self.path and "text/html" not in self.headers.get("Accept", ""):
                        self.send_cors_headers(200)
                        self.wfile.write(b'{"success":true}')
                    else:
                        self.send_cors_headers(200, "text/html; charset=utf-8")
                        self.wfile.write(render_mobile_portal_html(f"📄 PDF rebut des del mòbil (<code>{orig_fname}</code>). Extreient DOI/metadades i creant nota...").encode("utf-8"))
                    return

                # Cas 2: Fitxer HTML pujat (extensió SingleFile a Firefox Android o fitxer .html)
                html_snap = ""
                if file_obj and file_obj["bytes"]:
                    html_snap = file_obj["bytes"].decode("utf-8", errors="ignore")
                elif "text/html" in ctype or body.lstrip().lower().startswith(("<!doctype", "<html", "<!--")):
                    html_snap = body
                else:
                    for fk, fv in fields.items():
                        if isinstance(fv, str) and ("<!doctype" in fv.lower() or "<html" in fv.lower() or len(fv) > 500):
                            html_snap = fv
                            break

                print(f"📥 /singlefile debug: ctype={ctype}, len={len(raw_body)}, files={list(files.keys())}, fields={list(fields.keys())}, html_len={len(html_snap)}", file=sys.stderr)

                if html_snap and ("<html" in html_snap.lower() or "<!doctype" in html_snap.lower() or len(html_snap) > 300):
                    sf_url, sf_title, sf_date = extract_singlefile_metadata(html_snap, fallback_url=url_val, fallback_title=title_val)
                    print(f"📱 SingleFile (Android/Firefox): rebut snapshot HTML per a {sf_url or sf_title}", file=sys.stderr)
                    item = {
                        "itemType": "webpage",
                        "title": sf_title or "Snapshot Web",
                        "url": sf_url,
                        "html": html_snap,
                        "date": sf_date,
                        "is_singlefile": True
                    }
                    threading.Thread(target=process_zotero_item, args=(item,), daemon=True).start()
                    if "/singlefile" in self.path and "text/html" not in self.headers.get("Accept", ""):
                        self.send_cors_headers(200)
                        self.wfile.write(b'{"success":true}')
                    else:
                        self.send_cors_headers(200, "text/html; charset=utf-8")
                        self.wfile.write(render_mobile_portal_html(f"🌐 Snapshot SingleFile rebut: <b>{sf_title or sf_url}</b>. Desant HTML + PDF + Nota...").encode("utf-8"))
                    return

                # Cas 3: URL o DOI compartit des del menú Compartir d'Android o formulari
                shared_target = url_val or text_val
                if shared_target:
                    m_http = re.search(r'(https?://\S+)', shared_target)
                    target_arg = m_http.group(1) if m_http else shared_target.strip()
                    print(f"📱 Android: rebut enllaç/DOI compartit ({target_arg})", file=sys.stderr)
                    run_add_paper_async(target_arg, force_web=force_web)
                    self.send_cors_headers(200, "text/html; charset=utf-8")
                    self.wfile.write(render_mobile_portal_html(f"🔗 Enllaç rebut: <code>{target_arg}</code>. Processant amb Zoterless...").encode("utf-8"))
                    return

            except Exception as e:
                print(f"Error processant /singlefile o /ingest: {e}", file=sys.stderr)
                self.send_cors_headers(500)
                self.wfile.write(json.dumps({"error": str(e)}).encode("utf-8"))
                return

        self.send_cors_headers(200)
        self.wfile.write(b'{"success":true}')

    def log_message(self, format, *args):
        sys.stderr.write("[%s] %s - %s\n" % (self.log_date_time_string(), self.address_string(), format % args))

IDLE_TIMEOUT_SECONDS = 900  # 15 minuts d'inactivitat per alliberar el 100% de la RAM (quan corre via systemd)

def get_systemd_socket():
    """Detecta si s'ha iniciat mitjançant systemd socket activation (LISTEN_FDS)."""
    listen_fds = os.environ.get("LISTEN_FDS")
    listen_pid = os.environ.get("LISTEN_PID")
    if listen_fds and (not listen_pid or int(listen_pid) == os.getpid()):
        try:
            num_fds = int(listen_fds)
            if num_fds >= 1:
                import socket
                # El primer fd passat per systemd és sempre el 3 (SD_LISTEN_FDS_START)
                return socket.fromfd(3, socket.AF_INET, socket.SOCK_STREAM)
        except Exception as e:
            print(f"Avís obtenint socket de systemd: {e}", file=sys.stderr)
    return None

class SystemdThreadingTCPServer(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    def __init__(self, server_address, RequestHandlerClass, inherited_socket=None):
        if inherited_socket is not None:
            super().__init__(server_address, RequestHandlerClass, bind_and_activate=False)
            self.socket = inherited_socket
        else:
            super().__init__(server_address, RequestHandlerClass, bind_and_activate=True)

def start_idle_watchdog(server):
    """Vigila la inactivitat i tanca el servidor si no es fan peticions durant IDLE_TIMEOUT_SECONDS."""
    def watchdog():
        while True:
            time.sleep(30)
            if time.time() - LAST_REQUEST_TIME > IDLE_TIMEOUT_SECONDS:
                print(f"💤 Inactivitat de {IDLE_TIMEOUT_SECONDS}s assolida. Alliberant memòria a 0 MB (systemd socket romandrà actiu)...", file=sys.stderr)
                threading.Thread(target=server.shutdown, daemon=True).start()
                break
    t = threading.Thread(target=watchdog, daemon=True)
    t.start()

def run():
    sock = get_systemd_socket()
    if sock is not None:
        print(f"📡 Servidor Zotero Receiver activat via systemd socket (fd 3)...", file=sys.stderr)
        server = SystemdThreadingTCPServer(("0.0.0.0", PORT), ZoteroHandler, inherited_socket=sock)
        start_idle_watchdog(server)
    else:
        print(f"📡 Servidor Zotero Receiver escoltant a http://0.0.0.0:{PORT}...", file=sys.stderr)
        server = SystemdThreadingTCPServer(("0.0.0.0", PORT), ZoteroHandler)

    with server:
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            print("\nAturant servidor...")

if __name__ == "__main__":
    run()
