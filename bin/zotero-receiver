#!/usr/bin/env python3
"""
zotero-receiver: Emula el servidor local de Zotero al port 23119.
Rep peticions de Zotero Connector a Firefox i desa directament els articles
a biblioteca.bib, el PDF a pdfs/{citekey}.pdf i la nota a notes/@{citekey}.md.

Característiques avançades:
- Reconeixement automàtic de DOI (via camp DOI, extra, URL de catàleg Primo/Dialnet o cerca Crossref pel títol).
- Metadades canòniques des de Crossref per evitar entrades incompletes de catàlegs de biblioteques.
- Descàrrega automàtica de PDF en accés obert mitjançant Unpaywall i scraping de metadades.
- Detecció i enllaç automàtic de PDFs descarregats recentment a ~/Downloads/ (mitjançant anàlisi de text pdftotext).
- Compatibilitat amb la visualització directa de PDFs a Firefox (tant en línia com locals file://).
- Notificacions d'escriptori KDE.
"""

import http.server
import json
import os
