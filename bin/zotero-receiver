HEADERS = {
    "User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"
}

STOPWORDS = {
    "a", "an", "the", "and", "or", "of", "in", "on", "at", "to", "for", "with",
    "by", "from", "as", "is", "study", "per", "al", "de", "la", "el", "els",
    "les", "y", "en", "sobre", "un", "una", "los", "las", "del", "dels", "e", "o", "u"
}

def trigger_faristol_sync(citekey=None):
    """Avisa Faristol que s'ha afegit un document perquè s'actualitze la interfície a l'instant."""
    try:
        body = {"doc": f"@{citekey}.md"} if citekey else {}
        data = json.dumps(body).encode("utf-8")
        req = Request("http://127.0.0.1:8080/api/library/notify-change", data=data, headers={"Content-Type": "application/json"}, method="POST")
        with urlopen(req, timeout=0.8):
            pass
    except Exception:
        pass

def trigger_kate_sync(citekey=None):
    """Sincronitza en segon pla el projecte de Kate i Faristol per reflectir immediatament el nou article."""
    trigger_faristol_sync(citekey)
    try:
        sync_cmd = shutil.which("kate-sync-project") or str(Path.home() / ".local/bin/kate-sync-project")
        if Path(sync_cmd).is_file():
            subprocess.Popen([sync_cmd, "--quiet"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def focus_faristol_or_open(citekey):
    """Canvia a la pestanya fixada de Faristol a Firefox i obri el document, o fa fallback a xdg-open."""
    if not citekey:
        return

    # 1. Avisem Faristol per HTTP/SSE perquè la seua pestanya fixada òbriga el document
    try:
        payload = json.dumps({"doc": f"@{citekey}.md"}).encode("utf-8")
        req = Request("http://127.0.0.1:8080/api/library/open-document", data=payload, headers={"Content-Type": "application/json"}, method="POST")
        with urlopen(req, timeout=1.0):
            pass
    except Exception:
        pass

    # 2. Intentem activar la finestra de Firefox mitjançant KWin Scripting (Wayland / Plasma 6)
    firefox_activated = False
    try:
        import dbus, tempfile
        bus = dbus.SessionBus()
        scripting = bus.get_object("org.kde.KWin", "/Scripting")
        script_code = """
        var windows = workspace.windowList();
        for (var i = 0; i < windows.length; i++) {
            var w = windows[i];
            if (w.desktopFileName && w.desktopFileName.indexOf('firefox') !== -1) {
                workspace.activeWindow = w;
                break;
            }
        }
        """
        with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as f:
            f.write(script_code)
            temp_path = f.name
        try:
            script_id = scripting.loadScript(temp_path, dbus_interface="org.kde.kwin.Scripting")
            obj = bus.get_object("org.kde.KWin", f"/Scripting/Script{script_id}")
            obj.run(dbus_interface="org.kde.kwin.Script")
            obj.stop(dbus_interface="org.kde.kwin.Script")
            firefox_activated = True
        finally:
            if os.path.exists(temp_path):
                os.remove(temp_path)
    except Exception:
        pass

    # 3. Si Firefox s'ha activat, premem Ctrl+1 (tecles 29:1 2:1 2:0 29:0) per anar a la pestanya fixada de Faristol
    if firefox_activated:
        try:
            env = os.environ.copy()
            env["YDOTOOL_SOCKET"] = "/run/user/1000/.ydotool_socket"
            subprocess.run(["ydotool", "key", "29:1", "2:1", "2:0", "29:0"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
            return
        except Exception:
            pass

    # 4. Fallback: si no s'ha pogut activar la pestanya o no s'ha trobat Firefox, obrim per xdg-open
    url = f"http://127.0.0.1:8080/?doc=%40{quote(citekey)}.md"
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def is_valid_pdf_content(pdf_path, title="", abstract="", doi=""):
    """Comprova si el fitxer PDF té contingut acadèmic real i no és un avís antibot / paywall."""
    if not pdf_path.is_file():
        return False, "El fitxer no existeix."
    size = pdf_path.stat().st_size
    if size < 1000:
        return False, f"Mida massa petita ({size} bytes)."
    try:
        with open(pdf_path, "rb") as f:
            header = f.read(10)
        if not header.startswith(b"%PDF"):
            return False, "Capçalera no correspon a PDF."
    except Exception as e:
        return False, f"Error llegint: {e}"

    try:
        res = subprocess.run(["pdftotext", "-l", "2", str(pdf_path), "-"], capture_output=True, text=True, timeout=3)
        raw_text = res.stdout if res.returncode == 0 else ""
    except Exception:
        raw_text = ""

    text_lower = raw_text.lower()
    block_markers = [
        "javascript is disabled in your browser",
        "please enable javascript to proceed",
        "a required part of this site couldn't load",
        "attention required! | cloudflare",
        "just a moment...",
        "cf-browser-verification",
        "access denied",
        "403 forbidden",
        "subscription required",
        "purchase this article",
        "institutional login",
        "an error occurred while processing your request",
    ]
    for marker in block_markers:
        if marker in text_lower:
            return False, f"Bloqueig antibot: '{marker}'"

    if len(raw_text.strip()) < 120 and size < 35000:
        return False, "Text massa curt per a ser un article complet."

    return True, "PDF vàlid"

def notify(title, message, urgency="normal", citekey=None):
    """Envia una notificació d'escriptori mitjançant notify-send amb acció per obrir a Faristol."""
    def _send():
        cmd = [
            "notify-send",
            "-a", "Biblioteca",
            "-u", urgency,
            "-i", "accessories-dictionary"
        ]
        if citekey:
            cmd.extend([
                "--action=open=📖 Obrir a Faristol",
                "--action=default=Obrir"
            ])
        cmd.extend([title, message])

        try:
            res = subprocess.run(cmd, capture_output=True, text=True, timeout=25)
            action = res.stdout.strip().lower()
            if action in ("open", "default", "0", "1"):
                focus_faristol_or_open(citekey)
        except Exception:
            pass

    threading.Thread(target=_send, daemon=True).start()

def is_eduvpn_active():
    """Comprova si la connexió WireGuard / VPN de la universitat (EduVPN) està activa."""
    try:
        res = subprocess.run(
            ["nmcli", "-t", "-f", "NAME", "con", "show", "--active"],
            capture_output=True,
            text=True,
            timeout=2
        )
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                if "eduvpn" in line.strip().lower():
                    return True
    except Exception:
        pass
    return False

def strip_accents(text):
    """Translitera caràcters accentuats a caràcters ASCII equivalents (ex: á -> a, ñ -> n)."""
    if not text:
        return ""
    normalized = unicodedata.normalize("NFKD", text)
    return "".join(c for c in normalized if not unicodedata.combining(c))

def clean_latex(text):
    """Neteja caràcters LaTeX per a cadenes de text net."""
    if not text:
        return ""
    text = re.sub(r"\\['`^\"~]\{?([a-zA-Z])\}?", r"\1", text)
    text = re.sub(r'[\{\}\\]', '', text)
    text = text.replace('\n', ' ')
    return re.sub(r'\s+', ' ', text).strip()

def clean_title_for_search(title):
    """Elimina afegits típics de catàlegs de biblioteques com ' - Universidad de Valencia'."""
    if not title:
        return ""
    cleaned = re.sub(
        r'\s*[-–—|]\s*(Universidad|Universitat|Dialnet|UV|UVEG|repositori|Library|Catalog|Catálogo|Revista).*$',
        '',
        title,
        flags=re.IGNORECASE
    ).strip()
    return cleaned if cleaned else title

def clean_author_surname(first_author):
    """Extreu el primer cognom de forma neta evitant partícules ('de', 'la', 'van') i normalitzant accents."""
    has_comma = ',' in first_author
    raw = first_author.split(',')[0].strip() if has_comma else first_author.split(' and ')[0].strip()
    raw = re.sub(r'[\{\}\\]', '', raw).strip()
    raw = strip_accents(raw)
    parts = raw.split()
    particles = {"de", "del", "la", "van", "von", "der", "el", "al", "da", "di", "dos", "das"}
    while parts and parts[0].lower() in particles:
        parts.pop(0)
    if parts:
        if has_comma:
            last_name = parts[0].lower()
        else:
            if len(parts) > 1 and len(parts[-1]) <= 2:
                last_name = parts[-2].lower()
            else:
                last_name = parts[-1].lower()
    else:
        last_name = "desconegut"
    return re.sub(r'[^a-z\-]', '', last_name) or "desconegut"

def generate_citekey(first_author, title, year):
    """Genera citekey normalitzada a l'estil Better BibTeX: autorTitolAny."""
    last_name = clean_author_surname(first_author)
    title_clean = strip_accents(clean_latex(title))
    title_words = re.findall(r'[a-zA-Z0-9]+', title_clean)
    significant_words = [w.capitalize() for w in title_words if w.lower() not in STOPWORDS]
    short_title = "".join(significant_words[:3]) if significant_words else "Doc"
    year_str = str(year) if year else ""
    return f"{last_name}{short_title}{year_str}"

def extract_field(name, text):
    """Extreu el valor d'un camp BibTeX tenint en compte claus niades."""
    m = re.search(rf'\b{name}\s*=\s*', text, re.IGNORECASE)
    if not m:
        return ""
    start = m.end()
    if start >= len(text):
        return ""
    if text[start] == '{':
        depth = 0
        val = []
        for ch in text[start:]:
            if ch == '{':
                depth += 1
                if depth > 1:
                    val.append(ch)
            elif ch == '}':
                depth -= 1
                if depth == 0:
                    break
                val.append(ch)
            else:
                val.append(ch)
        return "".join(val)
    elif text[start] == '"':
        m_quote = re.search(r'^"([^"]*)"', text[start:])
        return m_quote.group(1) if m_quote else ""
    else:
        m_bare = re.match(r'^([^,\n]+)', text[start:])
        return m_bare.group(1).strip() if m_bare else ""

def extract_doi_from_text(text):
    """Cerca un patró de DOI en un text o URL."""
    if not text:
        return None
    # DOI estàndard
    m = re.search(r'\b(10\.\d{4,9}/[^\s"<>#]+)', text)
    if m:
        return m.group(1).rstrip(".,;)>]")
    # Catàleg Primo codificat: cdi_crossref_primary_10_18172_con_6302 o similar
    m_primo = re.search(r'(?:primary|doi)[/_](10_\d{4,9}_[^/?&\s]+)', text)
    if m_primo:
        cand = m_primo.group(1)
        # Convertir el primer guió baix en punt i el segon en barra
        parts = cand.split('_', 2)
        if len(parts) >= 3:
            doi_cand = f"{parts[0]}.{parts[1]}/{parts[2].replace('_', '.')}"
            return doi_cand
    return None

def extract_doi_from_pdf(pdf_path):
    """Extreu el DOI directament de les primeres pàgines o metadades del fitxer PDF."""
    if not Path(pdf_path).is_file():
        return None
    try:
        res_info = subprocess.run(["pdfinfo", str(pdf_path)], capture_output=True, text=True, timeout=4)
        if res_info.returncode == 0 and res_info.stdout:
            doi = extract_doi_from_text(res_info.stdout)
            if doi:
                return doi
    except Exception:
        pass
    try:
        res = subprocess.run(
            ["pdftotext", "-l", "3", str(pdf_path), "-"],
            capture_output=True, text=True, timeout=6
        )
        if res.returncode == 0 and res.stdout:
            doi = extract_doi_from_text(res.stdout)
            if doi:
                return doi
    except Exception:
        pass
    return None

def extract_title_guess_from_pdf(pdf_path, fallback_filename=""):
    """Intenta deduir el títol d'un PDF pujat quan no té DOI explícit."""
    if Path(pdf_path).is_file():
        try:
            res_info = subprocess.run(["pdfinfo", str(pdf_path)], capture_output=True, text=True, timeout=4)
            if res_info.returncode == 0 and res_info.stdout:
                m_t = re.search(r'^Title:\s*(.+)$', res_info.stdout, re.M)
                if m_t:
                    cand = m_t.group(1).strip()
                    if len(cand) > 8 and not cand.lower().endswith((".pdf", ".doc", ".docx", "untitled")):
                        return cand
        except Exception:
            pass
        try:
            res = subprocess.run(["pdftotext", "-l", "1", str(pdf_path), "-"], capture_output=True, text=True, timeout=5)
            if res.returncode == 0 and res.stdout:
                lines = [ln.strip() for ln in res.stdout.splitlines() if len(ln.strip()) > 12]
                for ln in lines[:8]:
                    if not re.search(r'(?:issn|isbn|doi|vol\.|volume|downloaded|copyright|http|www\.|journal|universit)', ln, re.I):
                        if 15 <= len(ln) <= 180:
                            return ln
        except Exception:
            pass
    if fallback_filename:
        clean_fn = re.sub(r'\.pdf$', '', fallback_filename, flags=re.I)
        clean_fn = re.sub(r'[_+\-]+', ' ', clean_fn).strip()
        if len(clean_fn) > 4:
            return clean_fn
    return "Document PDF"

def search_crossref_by_title(title):
    """Cerca a Crossref per títol per recuperar el DOI oficial."""
    clean_title = clean_title_for_search(title)
    if not clean_title or len(clean_title) < 8:
        return None
    try:
        q = quote(clean_title)
        url = f"https://api.crossref.org/works?query.bibliographic={q}&rows=1"
        req = Request(url, headers={**HEADERS, "User-Agent": "BibliotecaResearch/1.0 (mailto:casimir.research@uv.es)"})
        with urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            items = data.get("message", {}).get("items", [])
            if items:
                doi = items[0].get("DOI")
                found_title = items[0].get("title", [""])[0]
                words_clean = set(w for w in re.findall(r'[a-zA-Z0-9]+', clean_title.lower()) if w not in STOPWORDS and len(w) > 2)
                words_found = set(w for w in re.findall(r'[a-zA-Z0-9]+', found_title.lower()) if w not in STOPWORDS and len(w) > 2)
                if words_clean and words_found:
                    overlap = len(words_clean & words_found)
                    if (overlap / len(words_clean)) >= 0.60:
                        return doi
    except Exception as e:
        print(f"Error cercant DOI a Crossref: {e}", file=sys.stderr)
    return None

def fetch_bibtex_from_doi(doi):
    """Obté el registre BibTeX oficial des de doi.org per negociació de continguts."""
    try:
        url = f"https://doi.org/{doi}"
        req = Request(url, headers={**HEADERS, "Accept": "application/x-bibtex"})
        with urlopen(req, timeout=12) as resp:
            bib = resp.read().decode("utf-8", errors="ignore").strip()
            if bib.startswith("@"):
                return bib
    except Exception as e:
        print(f"Error obtenint BibTeX per a {doi}: {e}", file=sys.stderr)
    return None

def find_unpaywall_pdfs(doi):
    """Consulta Unpaywall (tots els repositoris institucionals) i OpenAlex per trobar les URLs del PDF en accés obert."""
    if not doi:
        return []

    candidates = []
    # 1. Unpaywall (multi-repositori)
    try:
        url = f"https://api.unpaywall.org/v2/{doi}?email=cavicas@alumni.uv.es"
        req = Request(url, headers=HEADERS)
        with urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            best = data.get("best_oa_location") or {}
            if best.get("url_for_pdf"):
                candidates.append(best["url_for_pdf"])
            elif best.get("url"):
                candidates.append(best["url"])
            for loc in data.get("oa_locations", []):
                u = loc.get("url_for_pdf") or loc.get("url")
                if u and u not in candidates:
                    candidates.append(u)
    except Exception as e:
        print(f"Unpaywall error: {e}", file=sys.stderr)

    # 2. OpenAlex (locations)
    try:
        oa_url = f"https://api.openalex.org/works/https://doi.org/{doi}"
        req = Request(oa_url, headers=HEADERS)
        with urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            best_loc = data.get("best_oa_location") or {}
            if best_loc.get("pdf_url") and best_loc["pdf_url"] not in candidates:
                candidates.append(best_loc["pdf_url"])
            prim_loc = data.get("primary_location") or {}
            if prim_loc.get("pdf_url") and prim_loc["pdf_url"] not in candidates:
                candidates.append(prim_loc["pdf_url"])
            for loc in data.get("locations", []):
                if loc.get("pdf_url") and loc["pdf_url"] not in candidates:
                    candidates.append(loc["pdf_url"])
            if data.get("open_access", {}).get("oa_url") and data["open_access"]["oa_url"] not in candidates:
                candidates.append(data["open_access"]["oa_url"])
    except Exception as e:
        print(f"OpenAlex error: {e}", file=sys.stderr)

    return candidates


def scrape_pdf_links_from_html(html, base_url):
    """Extreu enllaços de descàrrega de PDF a partir de l'HTML (estil KBibTeX / Dialnet / RODERIC / DSpace / Highwire)."""
    candidates = []
    # 1. Metadades acadèmiques estàndard (Highwire Press, Dublin Core, Eprints, Google Scholar)
    for m in re.finditer(r'<meta\s+name=["\'](?:citation_pdf_url|dc\.identifier|eprints\.document_url)["\']\s+content=["\']([^"\']+)["\']', html, re.I):
        candidates.append(m.group(1))
    for m in re.finditer(r'<meta\s+content=["\']([^"\']+)["\']\s+name=["\'](?:citation_pdf_url|dc\.identifier|eprints\.document_url)["\']', html, re.I):
        candidates.append(m.group(1))
    # 2. OJS PDF.js viewer variable (var pdfUrl = "...")
    for m in re.finditer(r'pdfUrl\s*=\s*["\']([^"\']+)["\']', html, re.I):
        cand = m.group(1).replace(r"\/", "/")
        candidates.append(cand)
    # 3. Enllaços OJS /article/download/
    for m in re.finditer(r'href=["\']([^"\']+/article/download/[^"\']+)["\']', html, re.I):
        candidates.append(m.group(1))
    # 4. Dialnet direct download links (/descarga/articulo/XXXXXX.pdf)
    for m in re.finditer(r'href=["\']([^"\']*/descarga/articulo/[^"\']+)["\']', html, re.I):
        candidates.append(m.group(1))
    # 5. Repositoris DSpace universitaris (RODERIC UV, RiuNet UPV, RUA UA, TDX Tesis)
    for m in re.finditer(r'href=["\']([^"\']*/bitstream/[^"\']+(?:\.pdf)?[^"\']*)["\']', html, re.I):
        candidates.append(m.group(1))
    # 6. Editorials internacionals (Springer, Wiley, ScienceDirect, IEEE, ACM)
    for m in re.finditer(r'href=["\']([^"\']*(?:/doi/pdf/|/doi/epdf/|/content/pdf/)[^"\']*)["\']', html, re.I):
        candidates.append(m.group(1))
    # 7. Classes de botons de descàrrega típiques
    for m in re.finditer(r'<a\b[^>]*class=["\'][^"\']*\b(?:c-pdf-download__link|pdf-download|download-pdf|article-btn-pdf|coolBar__ctrl|pdf-link)\b[^"\']*["\'][^>]*\bhref=["\']([^"\']+)["\']', html, re.I):
        candidates.append(m.group(1))
    for m in re.finditer(r'<a\b[^>]*\bhref=["\']([^"\']+)["\'][^>]*class=["\'][^"\']*\b(?:c-pdf-download__link|pdf-download|download-pdf|article-btn-pdf|coolBar__ctrl|pdf-link)\b[^"\']*["\']', html, re.I):
        candidates.append(m.group(1))
    # 8. Enllaços directes a fitxers .pdf
    for m in re.finditer(r'href=["\']([^"\']+\.pdf(?:\?[^"\']*)?)["\']', html, re.I):
        candidates.append(m.group(1))
    # 9. Visors incrustats / Iframe / Embed / Object (lectors web o repositoris OA)
    for m in re.finditer(r'<(?:iframe|embed|object)\b[^>]*(?:id=["\']pdf["\']|src=["\']([^"\']+)["\']|data=["\']([^"\']+)["\'])', html, re.I):
        cand = m.group(1) or m.group(2)
        if cand:
            candidates.append(cand)
        
    resolved = []
    for c in candidates:
        full_url = urljoin(base_url, c.strip())
        if full_url not in resolved:
            resolved.append(full_url)
    return resolved

def download_pdf_with_curl(pdf_url, target_path):
    """Descarrega el fitxer PDF amb curl seguint redireccions i enllaços interns OJS/Dialnet/KBibTeX."""
    if not pdf_url:
        return False
    temp_target = target_path.with_suffix(".tmp")
    target_path.parent.mkdir(parents=True, exist_ok=True)
    try:
        cmd = [
            "curl", "-skL", "--connect-timeout", "4", "--max-time", "15",
            "-A", HEADERS["User-Agent"],
            "-o", str(temp_target),
            pdf_url
        ]
        subprocess.run(cmd, check=False)
        if temp_target.is_file():
            data = temp_target.read_bytes()
            if data.startswith(b"%PDF"):
                is_valid, reason = is_valid_pdf_content(temp_target)
                if is_valid:
                    temp_target.replace(target_path)
                    return True
                else:
                    print(f"Avís: PDF descartat ({reason})", file=sys.stderr)
            # Detectar si és un bloqueig per bot challenge (com Fastly / Cloudflare)
            html = data.decode("utf-8", errors="ignore")
            if "Client Challenge" in html or "_fs_ch_st" in html or "cf-browser-verification" in html:
                temp_target.unlink()
                return False
            # Intentar detectar enllaç intern HTML explorant com fa KBibTeX
            candidates = scrape_pdf_links_from_html(html, pdf_url)
            for cand in candidates:
                cmd2 = [
                    "curl", "-skL", "--connect-timeout", "4", "--max-time", "15",
                    "-A", HEADERS["User-Agent"],
                    "-o", str(temp_target),
                    cand
                ]
                subprocess.run(cmd2, check=False)
                if temp_target.is_file():
                    data2 = temp_target.read_bytes()
                    if data2.startswith(b"%PDF"):
                        is_valid, reason = is_valid_pdf_content(temp_target)
                        if is_valid:
                            temp_target.replace(target_path)
                            return True
                        else:
                            print(f"Avís: PDF descartat ({reason})", file=sys.stderr)
        if temp_target.is_file():
            temp_target.unlink()
    except Exception as e:
        print(f"Error descarregant PDF de {pdf_url}: {e}", file=sys.stderr)
    return False

def find_recent_matching_pdf(citekey, title, first_author, doi, max_age_seconds=1800):
    """
    Cerca a ~/Downloads PDFs descarregats recentment que coincidisquen amb el document.
    Comprova mtime, nom de fitxer i contingut de text (pdftotext).
    """
    if not DOWNLOADS_DIR.is_dir():
        return None
        
    candidates = []
    now = time.time()
    for f in DOWNLOADS_DIR.glob("*.pdf"):
        try:
            mtime = f.stat().st_mtime
            age = now - mtime
            if age <= max_age_seconds:
                candidates.append((f, age))
        except Exception:
            pass
            
    if not candidates:
        return None
        
    candidates.sort(key=lambda x: x[1])
    
    doi_clean = doi.lower() if doi else ""
    author_clean = first_author.lower() if first_author else ""
    title_words = [w.lower() for w in re.findall(r'[a-zA-Z0-9]+', title) if len(w) > 3]
    
    best_file = None
    best_score = 0
    
    for f, age in candidates:
        score = 0
        fname = f.name.lower()
        if author_clean and author_clean in fname:
            score += 35
        if doi_clean and any(part in fname for part in doi_clean.split("/") if len(part) > 3):
            score += 45
        for tw in title_words[:5]:
            if tw in fname:
                score += 10
                
        # Comprovar la primera pàgina de text
        try:
            res = subprocess.run(
                ["pdftotext", "-l", "1", str(f), "-"],
                capture_output=True, text=True, timeout=3
            )
            txt = res.stdout.lower()
            if doi_clean and doi_clean in txt:
                score += 100
            if author_clean and author_clean in txt:
                score += 40
            matching_words = sum(1 for tw in title_words if tw in txt)
            score += matching_words * 5
        except Exception:
            pass
            
        # Si s'ha descarregat fa menys de 2 minuts
        if age < 120 and score > 0:
            score += 20
            
        if score > best_score and score >= 30:
            best_score = score
            best_file = f
            
    return best_file

def key_exists_in_bib(key, bib_file):
    """Comprova si una clau ja existeix a biblioteca.bib."""
    if not bib_file.is_file():
        return False
    content = bib_file.read_text(encoding="utf-8", errors="ignore")
    return bool(re.search(rf'@[a-zA-Z]+\s*\{{\s*{re.escape(key)}\s*,', content))

def append_or_update_bib(citekey, item_type, fields, bib_file):
    """Afegeix una entrada o actualitza el camp 'file' si abans faltava, amb bloqueig cooperatiu i escriptura atòmica."""
    import fcntl
    bib_file.parent.mkdir(parents=True, exist_ok=True)
    lock_path = bib_file.parent / f".{bib_file.name}.lock"
    with open(lock_path, "w", encoding="utf-8") as lock_f:
        fcntl.flock(lock_f, fcntl.LOCK_EX)
        try:
            if not key_exists_in_bib(citekey, bib_file):
                lines = [f"@{item_type}{{{citekey},"]
                for k, v in fields.items():
                    if v:
                        lines.append(f"  {k} = {{{v}}},")
                lines.append("}")
                entry = "\n".join(lines)
                existing = bib_file.read_text(encoding="utf-8", errors="ignore") if bib_file.is_file() else ""
                new_content = f"{existing}\n{entry}\n" if existing else f"{entry}\n"
                with tempfile.NamedTemporaryFile("w", dir=bib_file.parent, delete=False, encoding="utf-8") as tf:
                    tf.write(new_content)
                    tf.flush()
                    os.fsync(tf.fileno())
                    tmp_name = tf.name
                os.replace(tmp_name, bib_file)
            else:
                # Si ja existeix, comprovar si cal afegir o actualitzar el camp 'file'
                content = bib_file.read_text(encoding="utf-8", errors="ignore")
                pdf_file = fields.get("file")
                if pdf_file and f"file = {{{pdf_file}}}" not in content:
                    # Substituir o afegir file
                    m = re.search(rf'(@[a-zA-Z]+\s*\{{\s*{re.escape(citekey)}\s*,[\s\S]*?)(}})', content)
                    if m:
                        block = m.group(1)
                        if "file =" in block:
                            new_block = re.sub(r'file\s*=\s*\{[^}]*\}', f'file = {{{pdf_file}}}', block)
                        else:
                            new_block = block.rstrip()
                            if not new_block.endswith(','):
                                new_block += ','
                            new_block += f"\n  file = {{{pdf_file}}}\n"
                        new_content = content[:m.start()] + new_block + "}" + content[m.end():]
                        with tempfile.NamedTemporaryFile("w", dir=bib_file.parent, delete=False, encoding="utf-8") as tf:
                            tf.write(new_content)
                            tf.flush()
                            os.fsync(tf.fileno())
                            tmp_name = tf.name
                        os.replace(tmp_name, bib_file)
        finally:
            fcntl.flock(lock_f, fcntl.LOCK_UN)

_recent_saves_lock = threading.Lock()
_recent_saves = {}

def should_process_url(url):
    """Evita processar dues vegades seguides la mateixa URL si el connector envia múltiples esdeveniments."""
    if not url:
        return True
    now = time.time()
    with _recent_saves_lock:
        for u in list(_recent_saves.keys()):
            if now - _recent_saves[u] > 30:
                del _recent_saves[u]
        if url in _recent_saves:
            return False
        _recent_saves[url] = now
        return True

def process_zotero_item(item):
    """Processa un element rebut des de Zotero Connector i el desa a la biblioteca."""
    raw_title = item.get("title", "")
    item_url = item.get("url", "")
    extra = item.get("extra", "")
    item_type_raw = item.get("itemType", "")
    
    # 1. Si és un adjunt o PDF directe (per exemple, visualitzat a Firefox)
    local_source_pdf = None
    if item_url.startswith("file://"):
        local_path = Path(unquote(item_url[7:]))
        if local_path.is_file():
            local_source_pdf = local_path
            
    # 2. Resolució de DOI
    doi = item.get("DOI", "") or item.get("doi", "")
    if not doi:
        doi = extract_doi_from_text(extra)
    if not doi:
        doi = extract_doi_from_text(item_url)
    if not doi and local_source_pdf:
        doi = extract_doi_from_pdf(local_source_pdf)
        
    # Processar autors inicials
    creators = item.get("creators", [])
    author_list = []
    first_author_lastname = "desconegut"
    for c in creators:
        if c.get("lastName"):
            name = c["lastName"]
            if c.get("firstName"):
                name += f", {c['firstName']}"
            author_list.append(name)
            if first_author_lastname == "desconegut":
                first_author_lastname = c["lastName"]
        elif c.get("name"):
            author_list.append(c["name"])
            if first_author_lastname == "desconegut":
                first_author_lastname = c["name"].split()[-1]

    # Si no tenim DOI, cercar a Crossref pel títol NOMÉS si és un article acadèmic/llibre, MAI per a webs o blogs
    is_web = item_type_raw in ["webpage", "blogPost", "newspaperArticle", "magazineArticle", "post"]
    if not is_web and (not doi or first_author_lastname == "desconegut") and raw_title:
        discovered_doi = search_crossref_by_title(raw_title)
        if discovered_doi:
            doi = discovered_doi

    # 3. Recuperar metadades canòniques des de Crossref si tenim DOI
    canonical_bib = None
    if doi:
        canonical_bib = fetch_bibtex_from_doi(doi)

    title = raw_title
    year = ""
    journal = ""
    volume = ""
    issue = ""
    pages = ""
    item_type = "article"

    if canonical_bib:
        # Emprar les dades precises de Crossref
        cr_title = extract_field("title", canonical_bib)
        if cr_title:
            title = cr_title
        cr_author = extract_field("author", canonical_bib)
        if cr_author:
            author_str = cr_author
            first_author_lastname = clean_author_surname(cr_author)
        else:
            author_str = " and ".join(author_list) if author_list else "Desconegut"
            
        year = extract_field("year", canonical_bib)
        journal = extract_field("journal", canonical_bib)
        volume = extract_field("volume", canonical_bib)
        issue = extract_field("number", canonical_bib)
        pages = extract_field("pages", canonical_bib)
        
        m_type = re.match(r'@([a-zA-Z]+)\{', canonical_bib)
        if m_type:
            item_type = m_type.group(1).lower()
    else:
        # Emprar les dades proporcionades pel Connector
        if not author_list:
            author_list = ["Desconegut"]
        author_str = " and ".join(author_list)
        
        raw_date = str(item.get("date", ""))
        year_match = re.search(r'\b(19\d\d|20\d\d)\b', raw_date)
        year = year_match.group(1) if year_match else ""
        
        journal = item.get("publicationTitle", "") or item.get("journal", "") or item.get("websiteTitle", "")
        volume = item.get("volume", "")
        issue = item.get("issue", "")
        pages = item.get("pages", "")
        
        if item_type_raw in ["journalArticle", "magazineArticle", "newspaperArticle"]:
            item_type = "article"
        elif item_type_raw == "book":
            item_type = "book"
        elif item_type_raw == "bookSection":
            item_type = "incollection"
        elif item_type_raw in ["webpage", "blogPost", "post"]:
            item_type = "online"
        else:
            item_type = "misc"

    # 4. Citekey
    citekey = generate_citekey(first_author_lastname, title, year)
    target_pdf = PDF_DIR / f"{citekey}.pdf"
    target_html = PDF_DIR / f"{citekey}.html"
    pdf_saved = False
    html_saved = False

    # 5. Adquisició del PDF (Estratègia multicanal estil KBibTeX)
    if target_pdf.is_file():
        pdf_saved = True
    elif local_source_pdf and local_source_pdf.is_file():
        # Cas fitxer local ja obert a Firefox (file:///)
        try:
            PDF_DIR.mkdir(parents=True, exist_ok=True)
            import shutil
            shutil.copy2(local_source_pdf, target_pdf)
            pdf_saved = True
        except Exception as e:
            print(f"Error copiant fitxer local: {e}", file=sys.stderr)

    # 5a. Adjunts enviats per Zotero Connector
    if not pdf_saved:
        attachments = item.get("attachments", [])
        for att in attachments:
            att_url = att.get("url", "")
            mime = att.get("mimeType", "")
            if att_url.startswith("file://"):
                att_local = Path(unquote(att_url[7:]))
                if att_local.is_file():
                    import shutil
                    PDF_DIR.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(att_local, target_pdf)
                    pdf_saved = True
                    break
            elif mime == "application/pdf" or att_url.lower().endswith(".pdf"):
                if download_pdf_with_curl(att_url, target_pdf):
                    pdf_saved = True
                    break
            elif not is_web and ("download" in att_url.lower() or att_url.startswith("http")):
                if download_pdf_with_curl(att_url, target_pdf):
                    pdf_saved = True
                    break

    # 5b. La pàgina web on es troba l'usuari a Firefox (item_url)
    if not pdf_saved and item_url and item_url.startswith("http"):
        # Si és una revista OJS (/article/view/), provar directament la transformació a /article/download/
        if "/article/view/" in item_url:
            ojs_dl = item_url.replace("/article/view/", "/article/download/")
            if download_pdf_with_curl(ojs_dl, target_pdf):
                pdf_saved = True

        # Si és Dialnet (servlet/articulo?codigo=XXXXX), provar directament la descàrrega
        if not pdf_saved and "dialnet.unirioja.es/servlet/articulo" in item_url:
            m_dn = re.search(r'codigo=(\d+)', item_url)
            if m_dn:
                dialnet_dl = f"https://dialnet.unirioja.es/descarga/articulo/{m_dn.group(1)}.pdf"
                if download_pdf_with_curl(dialnet_dl, target_pdf):
                    pdf_saved = True

        # Provar scraping de la pàgina web NOMÉS si NO és una pàgina web/notícia/blog (on hi ha bàners o enllaços a PDFs arbitraris)
        # o si tenim un DOI explícit
        if not pdf_saved and not is_web:
            if download_pdf_with_curl(item_url, target_pdf):
                pdf_saved = True


    # 5c. Resolució directa del DOI (molts DOIs en accés obert com Eureka redirigeixen al PDF!)
    if not pdf_saved and doi:
        doi_url = f"https://doi.org/{doi}"
        if download_pdf_with_curl(doi_url, target_pdf):
            pdf_saved = True

    # 5d. Unpaywall i repositoris institucionals OA (multi-repositori)
    if not pdf_saved and doi:
        oa_candidates = find_unpaywall_pdfs(doi)
        for oa_url in oa_candidates:
            if download_pdf_with_curl(oa_url, target_pdf):
                pdf_saved = True
                break

    # 5e. Resolució avançada amb el motor unificat academic-spain
    if not pdf_saved and resolve_identifier_sync:
        try:
            cand_paper = resolve_identifier_sync(doi or item_url or title)
            if cand_paper and cand_paper.pdf_url:
                if download_pdf_with_curl(cand_paper.pdf_url, target_pdf):
                    pdf_saved = True
        except Exception as e_res:
            print(f"Avís resolent amb academic-spain: {e_res}", file=sys.stderr)

    # 5g. Detecció a ~/Downloads (per si l'usuari l'ha baixat abans o manualment)
    if not pdf_saved:
        matched_download = find_recent_matching_pdf(citekey, title, first_author_lastname, doi)
        if matched_download and matched_download.is_file():
            try:
                import shutil
                PDF_DIR.mkdir(parents=True, exist_ok=True)
                shutil.copy2(matched_download, target_pdf)
                pdf_saved = True
            except Exception as e:
                print(f"Error associant PDF des de Downloads: {e}", file=sys.stderr)

    # 5h. Captura de pàgina web / article a PDF net via Trafilatura + Pandoc/XeLaTeX (sense Chromium)
    web_article_text = ""
    if not pdf_saved and (item_url.startswith("http") or item.get("html")):
        try:
            import trafilatura
            downloaded = item.get("html") or ""
            if not downloaded and item_url.startswith("http"):
                downloaded = trafilatura.fetch_url(item_url)
            if not downloaded and item_url.startswith("http"):
                res = subprocess.run([
                    "curl", "-sL", "-A", HEADERS["User-Agent"], item_url
                ], capture_output=True, text=True, timeout=15)
                if res.returncode == 0 and res.stdout:
                    downloaded = res.stdout

            if downloaded:
                # Si ja tenim un snapshot SingleFile o és una pàgina web amb HTML però Trafilatura no trau text llarg, igualment desem el .html!
                raw_html_snap = item.get("html") or ""
                if raw_html_snap and ("<html" in raw_html_snap.lower() or "<!doctype" in raw_html_snap.lower() or len(raw_html_snap) > 500):
                    try:
                        PDF_DIR.mkdir(parents=True, exist_ok=True)
                        (PDF_DIR / f"{citekey}.html").write_text(raw_html_snap, encoding="utf-8")
                        html_saved = True
                    except Exception:
                        pass

                meta = trafilatura.extract_metadata(downloaded)
                article_md = trafilatura.extract(
                    downloaded,
                    output_format="markdown",
                    include_tables=True,
                    include_images=False
                )
                if article_md and len(article_md.strip()) > 80:
                    web_article_text = article_md.strip()
                    if (not title or title == "Sense títol") and meta and meta.title:
                        title = meta.title
                    if not author_str or author_str == "Desconegut":
                        if meta and meta.author:
                            author_str = meta.author
                        else:
                            m_aut = re.search(r'<[a-zA-Z0-9]+\b[^>]*class=["\'][^"\']*(?:author|autor|byline)[^"\']*["\'][^>]*>[\s\S]*?<a\b[^>]*>([^<]+)</a>', downloaded, re.I)
                            if not m_aut:
                                m_aut = re.search(r'href=["\']/auto(?:r|res)/[^"\']+["\'][^>]*>([^<]+)</a>', downloaded, re.I)
                            if m_aut:
                                author_str = m_aut.group(1).strip()
                            else:
                                m_title_aut = re.search(r'<title>([^<]+)</title>', downloaded, re.I)
                                if m_title_aut:
                                    parts = [p.strip() for p in re.split(r'\s*[-–—|]\s*', m_title_aut.group(1))]
                                    if len(parts) >= 3:
                                        author_str = parts[-2]
                    
                    if (not author_str or author_str == "Desconegut") and meta and meta.sitename:
                        author_str = meta.sitename

                    if not year:
                        if meta and meta.date:
                            ym = re.search(r'\b(19\d\d|20\d\d)\b', str(meta.date))
                            if ym:
                                year = ym.group(1)
                        if not year and item_url:
                            ym_url = re.search(r'/(19\d\d|20\d\d)/', item_url)
                            if ym_url:
                                year = ym_url.group(1)

                    if author_str and author_str != "Desconegut":
                        new_surname = clean_author_surname(author_str)
                        if new_surname != "desconegut":
                            first_author_lastname = new_surname
                    
                    old_citekey = citekey
                    citekey = generate_citekey(first_author_lastname, title, year)
                    if old_citekey != citekey and (PDF_DIR / f"{old_citekey}.html").is_file() and not (PDF_DIR / f"{citekey}.html").is_file():
                        try:
                            (PDF_DIR / f"{old_citekey}.html").replace(PDF_DIR / f"{citekey}.html")
                        except Exception:
                            pass
                    target_pdf = PDF_DIR / f"{citekey}.pdf"

                    if not journal and meta and meta.sitename:
                        journal = meta.sitename

                    # 5h-0. Si és una pàgina web o hem rebut un snapshot SingleFile/HTML de Firefox, desar també el fitxer .html íntegre!
                    target_html = PDF_DIR / f"{citekey}.html"
                    raw_html_snap = item.get("html") or ""
                    if raw_html_snap and ("<html" in raw_html_snap.lower() or "<!doctype" in raw_html_snap.lower() or len(raw_html_snap) > 500):
                        try:
                            PDF_DIR.mkdir(parents=True, exist_ok=True)
                            target_html.write_text(raw_html_snap, encoding="utf-8")
                            html_saved = True
                        except Exception as e_h:
                            print(f"Error desant snapshot HTML: {e_h}", file=sys.stderr)
                    elif is_web and downloaded and ("<html" in downloaded.lower() or "<!doctype" in downloaded.lower()):
                        try:
                            PDF_DIR.mkdir(parents=True, exist_ok=True)
                            # Assegurar base href perquè els recursos relatius carreguen si no era SingleFile pur
                            html_to_save = downloaded
                            if item_url.startswith("http") and "<base " not in html_to_save.lower():
                                html_to_save = re.sub(r'(<head\b[^>]*>)', rf'\1<base href="{item_url}">', html_to_save, count=1, flags=re.I)
                            target_html.write_text(html_to_save, encoding="utf-8")
                            html_saved = True
                        except Exception as e_h2:
                            print(f"Error desant HTML descarregat: {e_h2}", file=sys.stderr)

                    # 5h-1. Si prové de SingleFile, conservem exclusivament l'snapshot HTML pur (sense compilar PDF amb XeLaTeX)
                    is_sf = item.get("is_singlefile", False)
                    if not is_sf:
                        doc_title = clean_latex(title).replace('\n', ' ').strip()
                        doc_author = clean_latex(author_str).replace('\n', ' ').strip()
                        if meta and meta.sitename and meta.sitename not in doc_author:
                            doc_author = f"{doc_author} ({clean_latex(meta.sitename)})"
                        doc_date = str(year) if year else ""
                        if meta and meta.date:
                            doc_date = str(meta.date)

                        pdf_md = f"""---
title: {json.dumps(doc_title)}
author: {json.dumps(doc_author)}
date: {json.dumps(doc_date)}
geometry: "paperwidth=170mm,paperheight=240mm,top=1.8cm,bottom=1.8cm,left=1.8cm,right=1.8cm"
fontsize: 11pt
linestretch: 1.18
colorlinks: true
linkcolor: "0.1,0.2,0.6"
urlcolor: "0.1,0.2,0.6"
mainfont: "DejaVu Serif"
---

{web_article_text}
"""
                        tmp_md = Path(f"/tmp/web_capture_{citekey}.md")
                        tmp_md.write_text(pdf_md, encoding="utf-8")
                        PDF_DIR.mkdir(parents=True, exist_ok=True)
                        res = subprocess.run([
                            "pandoc", str(tmp_md),
                            "-o", str(target_pdf),
                            "--pdf-engine=xelatex"
                        ], capture_output=True, text=True, timeout=45)
                        if res.returncode == 0 and target_pdf.is_file() and target_pdf.stat().st_size > 500:
                            pdf_saved = True
                        try:
                            tmp_md.unlink(missing_ok=True)
                        except Exception:
                            pass
        except Exception as e:
            print(f"Error generant PDF d'article web amb Trafilatura/Pandoc: {e}", file=sys.stderr)

    # 6. Desar a biblioteca.bib
    raw_abstract = ""
    if canonical_bib:
        raw_abstract = extract_field("abstract", canonical_bib)
    if not raw_abstract:
        raw_abstract = item.get("abstractNote", "") or item.get("abstract", "")
    abstract_clean = re.sub(r'<[^>]+>', '', str(raw_abstract)).strip() if raw_abstract else ""
    if not abstract_clean and web_article_text:
        paras = [p.strip() for p in web_article_text.split('\n\n') if len(p.strip()) > 30 and not p.strip().startswith('#')]
        if paras:
            abstract_clean = paras[0][:400]

    fields = {
        "title": title,
        "author": author_str,
        "year": year,
        "journal": journal,
        "volume": volume,
        "number": issue,
        "pages": pages,
        "doi": doi,
        "url": item_url,
        "file": str(target_pdf) if pdf_saved else (str(PDF_DIR / f"{citekey}.html") if html_saved else "")
    }
    if abstract_clean:
        fields["abstract"] = abstract_clean
    append_or_update_bib(citekey, item_type, fields, BIB_FILE)

    # 7. Crear nota a notes/@citekey.md
    NOTES_DIR.mkdir(parents=True, exist_ok=True)
    note_path = NOTES_DIR / f"@{citekey}.md"
    if not note_path.is_file():
        extra_article_section = ""
        if web_article_text:
            extra_article_section = f"\n# Contingut de l'article\n\n{web_article_text}\n"
        clean_doi = (doi or "").strip()
        if clean_doi.lower() == "none":
            clean_doi = ""
        note_content = f"""---
title: "{clean_latex(title)}"
author: "{clean_latex(author_str)}"
year: {year or '""'}
citekey: "@{citekey}"
doi: "{clean_doi}"
url: "{item_url}"
tags: []
---
# Resum / Abstract

{abstract_clean}

# Idees clau

* 
{extra_article_section}"""
        note_path.write_text(note_content, encoding="utf-8")

    # 8. Notificació d'èxit
    if pdf_saved and html_saved:
        pdf_status = "🌐 Snapshot HTML + PDF desats"
    elif html_saved:
        pdf_status = "🌐 Snapshot HTML desat"
    elif pdf_saved:
        if web_article_text:
            pdf_status = "🌐 Article web maquetat a PDF"
        else:
            pdf_status = "📄 PDF desat"
    else:
        if not is_eduvpn_active():
            pdf_status = "⚠️ Sense PDF lliure (Connecta EduVPN UV per a accés institucional)"
        else:
            pdf_status = "⚠️ Sense PDF (de pagament o privat)"

    short_title = clean_latex(title)
    if len(short_title) > 60:
        short_title = short_title[:57] + "..."
    notify(f"📚 Zotero: @{citekey}", f"{short_title}\n{pdf_status} | 📝 Nota creada", citekey=citekey)

    # 9. Sincronitzar automàticament .kateproject i Faristol en segon pla
    trigger_kate_sync(citekey)
    return citekey

def extract_singlefile_metadata(html_text, fallback_url="", fallback_title=""):
    """Extreu URL, títol i data des de l'HTML generat per SingleFile."""
    url = fallback_url or ""
    title = fallback_title or ""
    date_str = ""
    if not url:
        m_sf_url = re.search(r'Page saved with SingleFile\s+url:\s*(\S+)', html_text, re.I)
        if m_sf_url:
            url = m_sf_url.group(1).strip()
    if not url:
        m_canon = re.search(r'<link[^>]+rel=["\']canonical["\'][^>]+href=["\']([^"\']+)["\']', html_text, re.I)
        if not m_canon:
            m_canon = re.search(r'<meta[^>]+property=["\']og:url["\'][^>]+content=["\']([^"\']+)["\']', html_text, re.I)
        if m_canon:
            url = m_canon.group(1).strip()
    if not title:
        m_og_title = re.search(r'<meta[^>]+property=["\']og:title["\'][^>]+content=["\']([^"\']+)["\']', html_text, re.I)
        if m_og_title:
            title = m_og_title.group(1).strip()
        else:
            m_title = re.search(r'<title[^>]*>([\s\S]*?)</title>', html_text, re.I)
            if m_title:
                title = re.sub(r'\s+', ' ', m_title.group(1)).strip()
    m_sf_date = re.search(r'saved date:\s*([^\r\n]+)', html_text, re.I)
    if m_sf_date:
        ym = re.search(r'\b(19\d\d|20\d\d)\b', m_sf_date.group(1))
        if ym:
            date_str = ym.group(1)
    return url, title, date_str

def run_add_paper_async(arg_val, direct_pdf=None, force_web=False):
    """Executa add-paper en segon pla per a ingesta des d'Android / Web."""
    def _worker():
        cmd = [str(Path.home() / "Projects/zoterless/bin/add-paper")]
        if force_web:
            cmd.append("--web")
        if direct_pdf:
            cmd.extend(["--pdf", str(direct_pdf)])
        if arg_val:
            cmd.append(str(arg_val))
        try:
            subprocess.run(cmd, timeout=120)
            trigger_kate_sync()
        except Exception as e:
            print(f"Error executant add-paper des de mòbil: {e}", file=sys.stderr)
    threading.Thread(target=_worker, daemon=True).start()

