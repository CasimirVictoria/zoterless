#!/usr/bin/env python3
"""
add-paper: Afegeix un article científic a la biblioteca a partir d'un DOI, arXiv, URL o metadades.
Llegeix l'entrada de la línia d'ordres, del cercador interactiu (-s / --search),
d'un marcador de navegador o del portapapers (Wayland/X11).

Flux:
1. Reconeix DOI, arXiv, Dialnet o dades estructurades enviades des del navegador.
2. Si s'indica -s/--search, cerca interactivament a OpenAlex o Crossref i permet triar l'article.
3. Si no hi ha DOI directe, cerca a OpenAlex pel títol o resol el codi Dialnet.
4. Obté l'entrada BibTeX canònica des de Crossref (o construeix BibTeX estructurat).
5. Genera una citekey normalitzada (estil Better BibTeX: autorTitolAny).
6. Descarrega el PDF en accés obert (Unpaywall, Dialnet directe, repositoris DSpace o scraping KBibTeX).
7. Afegeix l'entrada amb el camp 'file' a ~/Documents/Biblioteca/biblioteca.bib.
8. Crea la nota bibliogràfica a ~/Documents/notes/@citekey.md.
9. Mostra una notificació nativa a l'escriptori KDE.
"""

import concurrent.futures
import json
import os
import re
import subprocess
import sys
import unicodedata
from pathlib import Path
from urllib.parse import quote, unquote, urljoin
from urllib.request import Request, urlopen
from urllib.error import URLError, HTTPError

BIB_FILE = Path.home() / "Documents/Biblioteca/biblioteca.bib"
PDF_DIR = Path.home() / "Documents/Biblioteca/pdfs"
NOTES_DIR = Path.home() / "Documents/notes"

HEADERS = {
    "User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"
}

def notify(title, message, urgency="normal"):
    """Envia una notificació d'escriptori mitjançant notify-send."""
    try:
        subprocess.run(
            ["notify-send", "-a", "Biblioteca", "-u", urgency, "-i", "accessories-dictionary", title, message],
            check=False
        )
    except Exception:
        pass

def is_eduvpn_active():
    """Comprova si la connexió WireGuard / VPN de la universitat (EduVPN) està activa."""
    try:
        res = subprocess.run(
            ["nmcli", "-t", "-f", "NAME", "con", "show", "--active"],
            capture_output=True,
            text=True,
            timeout=2
        )
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                if "eduvpn" in line.strip().lower():
                    return True
    except Exception:
        pass
    return False

def connect_eduvpn():
    """Intenta connectar la VPN institucional (EduVPN UV) mitjançant NetworkManager."""
    try:
        print("🔒 Connectant a EduVPN per a accés institucional...")
        res = subprocess.run(
            ["nmcli", "con", "up", "eduvpn"],
            capture_output=True,
            text=True,
            timeout=10
        )
        if res.returncode == 0:
            print("🟢 Connexió EduVPN establerta correctament.")
            return True
        else:
            print(f"⚠️ No s'ha pogut connectar EduVPN: {res.stderr.strip() or res.stdout.strip()}")
            return False
    except Exception as e:
        print(f"⚠️ Error connectant EduVPN: {e}")
        return False

def get_clipboard_text():
    """Llegeix el contingut del portapapers amb suport per a Wayland i X11."""
    try:
        res = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True, timeout=2)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    except Exception:
        pass
    try:
        res = subprocess.run(["xclip", "-selection", "clipboard", "-o"], capture_output=True, text=True, timeout=2)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    except Exception:
        pass
    return ""

def reconstruct_abstract(inv):
    """Reconstrueix el text de l'abstract a partir de l'inverted index d'OpenAlex."""
    if not inv or not isinstance(inv, dict):
        return ""
    word_pos = []
    for word, positions in inv.items():
        for pos in positions:
            word_pos.append((pos, word))
    word_pos.sort()
    return " ".join(w for _, w in word_pos)

def fetch_abstract_from_openalex(doi):
    """Obté i reconstrueix el resum de l'article a través de l'API d'OpenAlex."""
    if not doi:
        return ""
    try:
        clean_doi = doi.replace("https://doi.org/", "").strip()
        url = f"https://api.openalex.org/works/https://doi.org/{quote(clean_doi)}?mailto=casimir@users.noreply.github.com"
        req = Request(url, headers=HEADERS)
        with urlopen(req, timeout=4) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            inv = data.get("abstract_inverted_index")
            return reconstruct_abstract(inv)
    except Exception:
        return ""

def search_openalex(title_query):
    """Cerca a OpenAlex pel títol per trobar si l'article té DOI o PDF d'accés obert."""
    if not title_query:
        return None
    try:
        q = quote(title_query.strip())
        url = f"https://api.openalex.org/works?search={q}&mailto=casimir@users.noreply.github.com"
        req = Request(url, headers=HEADERS)
        with urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            results = data.get("results", [])
            if results:
                return results[0]
    except Exception as e:
        print(f"OpenAlex cercador error: {e}", file=sys.stderr)
    return None

def search_openalex_list(query, limit=5):
    """Cerca a OpenAlex múltiples resultats amb títol, autors, any, DOI i enllaç OA."""
    if not query:
        return []
    try:
        q = quote(query.strip())
        url = f"https://api.openalex.org/works?search={q}&per_page={limit}&sort=relevance_score:desc&mailto=casimir@users.noreply.github.com"
        req = Request(url, headers=HEADERS)
        with urlopen(req, timeout=6) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            results = []
            for item in data.get("results", []):
                authors = [a.get("author", {}).get("display_name", "") for a in item.get("authorships", [])]
                doi = (item.get("doi") or "").replace("https://doi.org/", "").strip()
                oa_url = item.get("open_access", {}).get("oa_url") or ""
                is_oa = item.get("open_access", {}).get("is_oa", False)
                inv = item.get("abstract_inverted_index")
                abstract = reconstruct_abstract(inv) if inv else ""
                results.append({
                    "title": item.get("display_name", "Sense títol"),
                    "authors": authors,
                    "year": str(item.get("publication_year", "")),
                    "doi": doi,
                    "abstract": abstract,
                    "is_oa": is_oa,
                    "oa_url": oa_url,
                    "id": item.get("id", ""),
                    "source": "OpenAlex"
                })
            return results
    except Exception as e:
        return []

def search_crossref_list(query, limit=5):
    """Cerca a Crossref directament al registre oficial de DOIs."""
    if not query:
        return []
    try:
        q = quote(query.strip())
        url = f"https://api.crossref.org/works?query={q}&rows={limit}&mailto=casimir@users.noreply.github.com"
        req = Request(url, headers=HEADERS)
        with urlopen(req, timeout=6) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            items = data.get("message", {}).get("items", [])
            results = []
            for item in items:
                authors = []
                for a in item.get("author", []):
                    given = a.get("given", "")
                    family = a.get("family", "")
                    name = f"{given} {family}".strip() if given or family else a.get("name", "")
                    if name:
                        authors.append(name)
                title = item.get("title", ["Sense títol"])[0] if item.get("title") else "Sense títol"
                year = ""
                parts = item.get("issued", {}).get("date-parts", [[]])[0]
                if parts:
                    year = str(parts[0])
                doi = item.get("DOI", "")
                raw_abs = item.get("abstract", "")
                abstract = re.sub(r'<[^>]+>', '', raw_abs).strip() if raw_abs else ""
                results.append({
                    "title": title,
                    "authors": authors,
                    "year": year,
                    "doi": doi,
                    "abstract": abstract,
                    "is_oa": False,
                    "oa_url": "",
                    "id": doi,
                    "source": "Crossref"
                })
            return results
    except Exception as e:
        return []

def search_eric_list(query, limit=5):
    """Cerca a ERIC (Education Resources Information Center) de l'Institut de Ciències de l'Educació."""
    if not query:
        return []
    try:
        q = quote(query.strip())
        url = f"https://api.ies.ed.gov/eric/?search={q}&rows={limit}&format=json"
        req = Request(url, headers=HEADERS)
        with urlopen(req, timeout=6) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            docs = data.get("response", {}).get("docs", [])
            results = []
            for d in docs:
                authors = d.get("author", [])
                if isinstance(authors, str):
                    authors = [authors]
                eid = d.get("id", "")
                is_ed = eid.startswith("ED")
                abstract = d.get("description", "")
                results.append({
                    "title": d.get("title", "Sense títol"),
                    "authors": authors,
                    "year": str(d.get("publicationdateyear") or d.get("pubyear", "")),
                    "doi": "",
                    "abstract": abstract,
                    "eric_id": eid,
                    "is_oa": is_ed,
                    "oa_url": f"https://files.eric.ed.gov/fulltext/{eid}.pdf" if is_ed else "",
                    "source": "ERIC"
                })
            return results
    except Exception:
        return []

def search_dialnet_list(query, limit=5):
    """Cerca a Dialnet literatura acadèmica en espanyol i català."""
    if not query:
        return []
    try:
        q = quote(query.strip())
        url = f"https://dialnet.unirioja.es/buscar/documentos?querysDismax.DOCUMENTAL_TODO={q}"
        req = Request(url, headers=HEADERS)
        with urlopen(req, timeout=5) as resp:
            html = resp.read().decode("utf-8", errors="ignore")
            matches = re.finditer(
                r"<li\s+id=[\'\"]articulo(\d+)[\'\"][^>]*>.*?<p\s+class=[\'\"]titulo[\'\"]>.*?<a\s+href=[\'\"][^>]*codigo=(\d+)[^>]*>([^<]+)</a>(.*?)<p\s+class=[\'\"]autores[\'\"]>(.*?)</p>",
                html, re.DOTALL | re.IGNORECASE
            )
            results = []
            for m in matches:
                codigo = m.group(2)
                title = m.group(3).strip()
                autores_html = m.group(5)
                authors = [a.strip() for a in re.findall(r"<a[^>]*>([^<]+)</a>", autores_html)]
                results.append({
                    "title": title,
                    "authors": authors,
                    "year": "",
                    "doi": "",
                    "dialnet_id": codigo,
                    "is_oa": True,
                    "oa_url": f"https://dialnet.unirioja.es/descarga/articulo/{codigo}.pdf",
                    "source": "Dialnet"
                })
                if len(results) >= limit:
                    break
            return results
    except Exception:
        return []

def normalize_title(t):
    """Normalitza un títol per a comparació i deduplicació (sense accents, minúscules, alfanumèric)."""
    if not t:
        return ""
    clean = strip_accents(clean_latex(t)).lower()
    return re.sub(r'[^a-z0-9]', '', clean)

def expand_query_multilingual(query):
    """Tradueix localment la consulta a l'anglès (per a bases internacionals) i al castellà (per a Dialnet) amb Argos Translate."""
    queries = {"original": query, "en": query, "es": query}
    try:
        import contextlib
        import io
        import logging
        import warnings
        os.environ["STANZA_LOGGING_LEVEL"] = "ERROR"
        logging.getLogger("argostranslate").setLevel(logging.ERROR)
        warnings.filterwarnings("ignore")

        sink = io.StringIO()
        with contextlib.redirect_stderr(sink):
            import argostranslate.translate
            
            langs = {l.code: l for l in argostranslate.translate.get_installed_languages()}
            ca, en, es = langs.get("ca"), langs.get("en"), langs.get("es")
            
            q_lower = f" {query.lower().strip()} "
            is_ca = any(w in q_lower for w in [" l'", " d'", " els ", " les ", " dels ", " amb ", " i ", " per ", " educacio ", " primaria ", " pensament ", " fisica ", " ciencia "]) or any(c in query for c in "àèéíòóúç·")
            is_en = any(w in q_lower for w in [" the ", " in ", " of ", " and ", " for ", " to ", " with ", " on ", " learning ", " school ", " education ", " thinking "])
            
            if is_ca and ca and en and es:
                tr_ca_en = ca.get_translation(en)
                if tr_ca_en:
                    en_trans = tr_ca_en.translate(query)
                    queries["en"] = en_trans.strip()
                    tr_en_es = en.get_translation(es)
                    if tr_en_es:
                        queries["es"] = tr_en_es.translate(en_trans).strip()
            elif not is_en and es and en:
                tr_es_en = es.get_translation(en)
                if tr_es_en:
                    queries["en"] = tr_es_en.translate(query).strip()
                    queries["es"] = query.strip()
            elif is_en and en and es:
                tr_en_es = en.get_translation(es)
                if tr_en_es:
                    queries["es"] = tr_en_es.translate(query).strip()
                    queries["en"] = query.strip()
    except Exception:
        pass
    return queries

def federated_search(query, limit_per_source=5):
    """Cerca en paral·lel a OpenAlex, ERIC, Crossref i Dialnet traduint automàticament amb Argos Translate."""
    multilingual = expand_query_multilingual(query)
    q_orig = multilingual["original"]
    q_en = multilingual["en"]
    q_es = multilingual["es"]
    
    if q_en.lower() != q_orig.lower() or q_es.lower() != q_orig.lower():
        print("🌐 Traducció automàtica local (Argos Translate):")
        if q_en.lower() != q_orig.lower():
            print(f"   🇬🇧 Anglès (ERIC, OpenAlex, Crossref): \"{q_en}\"")
        if q_es.lower() != q_orig.lower():
            print(f"   🇪🇸 Castellà (Dialnet): \"{q_es}\"")

    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as executor:
        futures = []
        # 1. Bases internacionals amb la versió anglesa
        futures.append(executor.submit(search_openalex_list, q_en, limit_per_source))
        futures.append(executor.submit(search_eric_list, q_en, limit_per_source))
        futures.append(executor.submit(search_crossref_list, q_en, limit_per_source))
        
        # 2. Si la consulta original era en català/castellà, consultar també OpenAlex per a articles locals
        if q_en.lower() != q_orig.lower():
            futures.append(executor.submit(search_openalex_list, q_orig, limit_per_source))
            
        # 3. Dialnet amb la versió castellana i original
        futures.append(executor.submit(search_dialnet_list, q_es, limit_per_source))
        if q_orig.lower() != q_es.lower():
            futures.append(executor.submit(search_dialnet_list, q_orig, limit_per_source))
        
        all_items = []
        for f in futures:
            try:
                res = f.result(timeout=6)
                if res:
                    all_items.extend(res)
            except Exception:
                pass
                
    merged = []
    doi_map = {}
    title_map = {}
    
    for item in all_items:
        if "sources" not in item:
            item["sources"] = [item.get("source", "Desconegut")]
            
        doi = (item.get("doi") or "").lower().strip()
        norm_t = normalize_title(item.get("title", ""))
        
        existing = None
        if doi and doi in doi_map:
            existing = doi_map[doi]
        elif norm_t and len(norm_t) > 15 and norm_t in title_map:
            existing = title_map[norm_t]
            
        if existing:
            # Fussionar les fonts sense duplicats
            for s in item["sources"]:
                if s not in existing["sources"]:
                    existing["sources"].append(s)
            # Enriquir camps complementaris
            if not existing.get("doi") and doi:
                existing["doi"] = doi
                doi_map[doi] = existing
            if not existing.get("year") and item.get("year"):
                existing["year"] = item["year"]
            if not existing.get("is_oa") and item.get("is_oa"):
                existing["is_oa"] = True
                existing["oa_url"] = item.get("oa_url", "")
            if not existing.get("dialnet_id") and item.get("dialnet_id"):
                existing["dialnet_id"] = item["dialnet_id"]
            if not existing.get("eric_id") and item.get("eric_id"):
                existing["eric_id"] = item["eric_id"]
            if not existing.get("abstract") and item.get("abstract"):
                existing["abstract"] = item["abstract"]
            if len(item.get("authors", [])) > len(existing.get("authors", [])):
                existing["authors"] = item["authors"]
        else:
            merged.append(item)
            if doi:
                doi_map[doi] = item
            if norm_t and len(norm_t) > 15:
                title_map[norm_t] = item

    # Ordenar: prioritzar els articles trobats a múltiples fonts i amb accés obert
    merged.sort(key=lambda x: (len(x.get("sources", [])), 1 if x.get("is_oa") else 0), reverse=True)
    return merged

def extract_doi_from_html(url):
    """Extreu el DOI d'una pàgina web acadèmica a través de les metadades HTML."""
    try:
        req = Request(url, headers=HEADERS)
        with urlopen(req, timeout=10) as resp:
            html = resp.read().decode("utf-8", errors="ignore")
        
        m = re.search(r'<meta\s+name=["\'](?:citation_doi|DC\.Identifier\.DOI)["\']\s+content=["\']([^"\']+)["\']', html, re.IGNORECASE)
        if m:
            return m.group(1).strip()
        m2 = re.search(r'<meta\s+content=["\']([^"\']+)["\']\s+name=["\'](?:citation_doi|DC\.Identifier\.DOI)["\']', html, re.IGNORECASE)
        if m2:
            return m2.group(1).strip()
        m_doi = re.search(r'\b(10\.\d{4,9}/[^\s"<>]+)', html)
        if m_doi:
            return m_doi.group(1).rstrip(".,;)>]")
    except Exception as e:
        print(f"Error explorant la pàgina web: {e}", file=sys.stderr)
    return None

def resolve_dialnet(text):
    """Detecta URL o identificador de Dialnet i resol DOI canònic i descàrrega directa de PDF."""
    m_dn = re.search(r'(?:dialnet\.unirioja\.es/(?:servlet/articulo\?codigo=|descarga/articulo/)|dialnet:)(\d+)', text, re.I)
    if not m_dn:
        return None, None, None, {}
    codigo = m_dn.group(1)
    pdf_url = f"https://dialnet.unirioja.es/descarga/articulo/{codigo}.pdf"
    
    doi = None
    title = None
    meta = {"pdf_url": pdf_url}
    
    page_url = f"https://dialnet.unirioja.es/servlet/articulo?codigo={codigo}"
    try:
        req = Request(page_url, headers=HEADERS)
        try:
            with urlopen(req, timeout=8) as resp:
                html = resp.read().decode("utf-8", errors="ignore")
        except HTTPError as he:
            html = he.read().decode("utf-8", errors="ignore")
            
        m_doi = re.search(r'<meta\s+name=["\']citation_doi["\']\s+content=["\']([^"\']+)["\']', html, re.I)
        if m_doi:
            doi = m_doi.group(1).strip()
        else:
            m_doi2 = re.search(r'\b(10\.\d{4,9}/[^\s"<>]+)', html)
            if m_doi2:
                doi = m_doi2.group(1).rstrip(".,;)>]")
                
        m_title = re.search(r'<meta\s+name=["\']citation_title["\']\s+content=["\']([^"\']+)["\']', html, re.I)
        if m_title:
            title = m_title.group(1).strip()
            meta["title"] = title
            
        m_author = re.findall(r'<meta\s+name=["\']citation_author["\']\s+content=["\']([^"\']+)["\']', html, re.I)
        if m_author:
            meta["authors"] = [a.strip() for a in m_author]
            
        m_date = re.search(r'<meta\s+name=["\']citation_date["\']\s+content=["\']([^"\']+)["\']', html, re.I)
        if m_date:
            meta["year"] = m_date.group(1).strip()
            
        m_journal = re.search(r'<meta\s+name=["\']citation_journal_title["\']\s+content=["\']([^"\']+)["\']', html, re.I)
        if m_journal:
            meta["journal"] = m_journal.group(1).strip()

        # Si tenim el títol però no el DOI directe a Dialnet, cerquem a OpenAlex
        if title and not doi:
            oa = search_openalex(title)
            if oa and oa.get("doi"):
                doi = oa["doi"].replace("https://doi.org/", "").strip()
                if not pdf_url and oa.get("open_access", {}).get("oa_url"):
                    pdf_url = oa["open_access"]["oa_url"]
    except Exception as e:
        print(f"Dialnet resolver: {e}", file=sys.stderr)
        
    return doi, pdf_url, title, meta

def resolve_doi_or_arxiv(text):
    """Detecta i normalitza un DOI, identificador d'arXiv o Dialnet a partir de text o URL."""
    text = unquote(text).strip()
    if not text:
        return None, None

    # Netejar possibles esquemes d'URL com bibtex:// o bib://
    text = re.sub(r'^(?:bibtex|bib):\/?\/?', '', text, flags=re.IGNORECASE).strip()
    text = unquote(text).strip()

    # Comprovació Dialnet
    if "dialnet" in text.lower() or "codigo=" in text.lower():
        doi, direct_pdf, title, meta = resolve_dialnet(text)
        if doi:
            return doi, direct_pdf

    # 1. Comprovació DOI directe (prioritari: 10.xxxx/...)
    m_doi = re.search(r'\b(10\.\d{4,9}/[^\s"<>]+)', text)
    if m_doi:
        doi = m_doi.group(1).rstrip(".,;)>]")
        return doi, None

    # 2. Comprovació arXiv (amb prefix explícit o número aïllat)
    m_arxiv = re.search(r'(?:arxiv\.org/(?:abs|pdf)/|arxiv:\s*)(\d{4}\.\d{4,5}(?:v\d+)?)', text, re.IGNORECASE)
    if not m_arxiv:
        m_arxiv = re.fullmatch(r'(\d{4}\.\d{4,5}(?:v\d+)?)', text.strip())
    if m_arxiv:
        arxiv_id = m_arxiv.group(1)
        return f"10.48550/arXiv.{arxiv_id}", f"https://arxiv.org/pdf/{arxiv_id}.pdf"
        
    # Si és una URL general, intentar extreure'n el DOI explorant el codi font
    if text.startswith("http://") or text.startswith("https://"):
        doi = extract_doi_from_html(text)
        if doi:
            return doi, None
            
    return None, None

def fetch_bibtex_from_doi(doi):
    """Obté l'entrada BibTeX des de Crossref emprant negociació de continguts."""
    url = f"https://doi.org/{doi}"
    headers = {**HEADERS, "Accept": "application/x-bibtex"}
    req = Request(url, headers=headers)
    with urlopen(req, timeout=15) as resp:
        return resp.read().decode("utf-8", errors="ignore").strip()

def strip_accents(text):
    """Translitera caràcters accentuats a caràcters ASCII equivalents (ex: á -> a, ñ -> n)."""
    if not text:
        return ""
    normalized = unicodedata.normalize("NFKD", text)
    return "".join(c for c in normalized if not unicodedata.combining(c))

def clean_latex(text):
    """Neteja marques de format LaTeX."""
    if not text:
        return ""
    text = re.sub(r"\\['`^\"~]\{?([a-zA-Z])\}?", r"\1", text)
    text = re.sub(r'[\{\}\\]', '', text)
    text = text.replace('\n', ' ')
    return re.sub(r'\s+', ' ', text).strip()

def clean_author_surname(first_author):
    """Extreu el primer cognom de forma neta evitant partícules ('de', 'la', 'van') i normalitzant accents."""
    raw = first_author.split(',')[0].strip() if ',' in first_author else first_author.split(' and ')[0].strip()
    raw = re.sub(r'[\{\}\\]', '', raw).strip()
    raw = strip_accents(raw)
    parts = raw.split()
    particles = {"de", "del", "la", "van", "von", "der", "el", "al", "da", "di"}
    while parts and parts[0].lower() in particles:
        parts.pop(0)
    if parts:
        last_name = parts[0].lower()
    else:
        last_name = "desconegut"
    return re.sub(r'[^a-z\-]', '', last_name) or "desconegut"

def generate_citekey(author, title, year):
    """Genera una citekey idèntica a l'estil per defecte de Better BibTeX (autorTitolAny)."""
    last_name = clean_author_surname(author)
    stopwords = {
        "a", "an", "the", "and", "or", "of", "in", "on", "at", "to", "for", "with",
        "by", "from", "as", "is", "study", "per", "al", "de", "la", "el", "els",
        "les", "y", "en", "sobre", "un", "una", "los", "las", "del", "dels", "e", "o", "u"
    }
    title_clean = strip_accents(clean_latex(title))
    title_words = re.findall(r'[a-zA-Z0-9]+', title_clean)
    significant_words = [w.capitalize() for w in title_words if w.lower() not in stopwords]
    short_title = "".join(significant_words[:3]) if significant_words else "Doc"
    
    year_str = str(year) if year else ""
    return f"{last_name}{short_title}{year_str}"

def extract_field(name, text):
    """Extreu el valor d'un camp BibTeX amb claus niades."""
    m = re.search(rf'\b{name}\s*=\s*', text, re.IGNORECASE)
    if not m:
        return ""
    start = m.end()
    if start >= len(text):
        return ""
    if text[start] == '{':
        depth = 0
        val = []
        for ch in text[start:]:
            if ch == '{':
                depth += 1
                if depth > 1:
                    val.append(ch)
            elif ch == '}':
                depth -= 1
                if depth == 0:
                    break
                val.append(ch)
            else:
                val.append(ch)
        return "".join(val)
    elif text[start] == '"':
        m_quote = re.search(r'^"([^"]*)"', text[start:])
        return m_quote.group(1) if m_quote else ""
    else:
        m_bare = re.match(r'^([^,\n]+)', text[start:])
        return m_bare.group(1).strip() if m_bare else ""

def build_bibtex_from_dict(citekey, meta, pdf_path):
    """Construeix una entrada BibTeX neta a partir d'un diccionari de metadades."""
    title = meta.get("title", "Sense títol")
    authors = meta.get("authors", [])
    if isinstance(authors, list):
        author_str = " and ".join(authors) if authors else "Desconegut"
    else:
        author_str = str(authors)
        
    year = meta.get("year", "")
    journal = meta.get("journal", "")
    url = meta.get("url", "")
    doi = meta.get("doi", "")
    
    lines = [f"@article{{{citekey},"]
    lines.append(f"  title = {{{title}}},")
    lines.append(f"  author = {{{author_str}}},")
    if year:
        lines.append(f"  year = {{{year}}},")
    if journal:
        lines.append(f"  journal = {{{journal}}},")
    if doi:
        lines.append(f"  doi = {{{doi}}},")
    if url:
        lines.append(f"  url = {{{url}}},")
    lines.append(f"  file = {{{pdf_path}}}")
    lines.append("}")
    return "\n".join(lines)

def scrape_pdf_links_from_html(html, base_url):
    """Extreu enllaços de descàrrega de PDF a partir de l'HTML (estil KBibTeX / Dialnet / RODERIC / DSpace / Highwire)."""
    candidates = []
    # 1. Metadades acadèmiques estàndard (Highwire Press, Dublin Core, Eprints, Google Scholar)
    for m in re.finditer(r'<meta\s+name=["\'](?:citation_pdf_url|dc\.identifier|eprints\.document_url)["\']\s+content=["\']([^"\']+)["\']', html, re.I):
        candidates.append(m.group(1))
    for m in re.finditer(r'<meta\s+content=["\']([^"\']+)["\']\s+name=["\'](?:citation_pdf_url|dc\.identifier|eprints\.document_url)["\']', html, re.I):
        candidates.append(m.group(1))
    # 2. Variables JS incrustades (com 'pdfUrl = "..."' de certs visors)
    for m in re.finditer(r'(?:var|let|const)?\s*pdfUrl\s*=\s*["\']([^"\']+)["\']', html, re.I):
        candidates.append(m.group(1))
    # 3. Enllaços OJS /article/download/
    for m in re.finditer(r'href=["\']([^"\']+/article/download/[^"\']+)["\']', html, re.I):
        candidates.append(m.group(1))
    # 4. Dialnet direct download links (/descarga/articulo/XXXXXX.pdf)
    for m in re.finditer(r'href=["\']([^"\']*/descarga/articulo/[^"\']+)["\']', html, re.I):
        candidates.append(m.group(1))
    # 5. Repositoris DSpace universitaris (RODERIC UV, RiuNet UPV, RUA UA, TDX Tesis)
    for m in re.finditer(r'href=["\']([^"\']*/bitstream/[^"\']+(?:\.pdf)?[^"\']*)["\']', html, re.I):
        candidates.append(m.group(1))
    # 6. Editorials internacionals (Springer, Wiley, ScienceDirect, IEEE, ACM)
    for m in re.finditer(r'href=["\']([^"\']*(?:/doi/pdf/|/doi/epdf/|/content/pdf/)[^"\']*)["\']', html, re.I):
        candidates.append(m.group(1))
    # 7. Classes de botons de descàrrega típiques
    for m in re.finditer(r'<a\b[^>]*class=["\'][^"\']*\b(?:c-pdf-download__link|pdf-download|download-pdf|article-btn-pdf|coolBar__ctrl|pdf-link)\b[^"\']*["\'][^>]*\bhref=["\']([^"\']+)["\']', html, re.I):
        candidates.append(m.group(1))
    for m in re.finditer(r'<a\b[^>]*\bhref=["\']([^"\']+)["\'][^>]*class=["\'][^"\']*\b(?:c-pdf-download__link|pdf-download|download-pdf|article-btn-pdf|coolBar__ctrl|pdf-link)\b[^"\']*["\']', html, re.I):
        candidates.append(m.group(1))
    # 8. Enllaços directes a fitxers .pdf
    for m in re.finditer(r'href=["\']([^"\']+\.pdf(?:\?[^"\']*)?)["\']', html, re.I):
        candidates.append(m.group(1))
    # 9. Visors incrustats / Iframe / Embed / Object (lectors web o repositoris OA)
    for m in re.finditer(r'<(?:iframe|embed|object)\b[^>]*(?:id=["\']pdf["\']|src=["\']([^"\']+)["\']|data=["\']([^"\']+)["\'])', html, re.I):
        cand = m.group(1) or m.group(2)
        if cand:
            candidates.append(cand)
        
    resolved = []
    for c in candidates:
        full_url = urljoin(base_url, c.strip())
        if full_url not in resolved:
            resolved.append(full_url)
    return resolved

def find_pdf_url(doi, direct_pdf=None):
    """Localitza la URL de descàrrega directa del PDF (Unpaywall multi-repositori, OpenAlex i metadades)."""
    if direct_pdf:
        return direct_pdf
        
    if not doi:
        return None

    # 1. Consultar Unpaywall (tots els repositoris institucionals OA)
    try:
        unpaywall_url = f"https://api.unpaywall.org/v2/{doi}?email=cavicas@alumni.uv.es"
        req = Request(unpaywall_url, headers=HEADERS)
        with urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            # 1a. Millor ubicació OA
            best = data.get("best_oa_location")
            if best and best.get("url_for_pdf"):
                return best["url_for_pdf"]
            if best and best.get("url") and best["url"].lower().endswith(".pdf"):
                return best["url"]
            # 1b. Qualsevol altra ubicació OA (repositoris universitaris, preprint, PMC, Zenodo...)
            for loc in data.get("oa_locations", []):
                if loc.get("url_for_pdf"):
                    return loc["url_for_pdf"]
                if loc.get("url") and loc["url"].lower().endswith(".pdf"):
                    return loc["url"]
    except Exception as e:
        print(f"Unpaywall: {e}", file=sys.stderr)

    # 2. Consultar OpenAlex per a ubicacions OA addicionals
    try:
        oa_url = f"https://api.openalex.org/works/https://doi.org/{doi}"
        req = Request(oa_url, headers=HEADERS)
        with urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            best_loc = data.get("best_oa_location") or {}
            if best_loc.get("pdf_url"):
                return best_loc["pdf_url"]
            prim_loc = data.get("primary_location") or {}
            if prim_loc.get("pdf_url"):
                return prim_loc["pdf_url"]
            for loc in data.get("locations", []):
                if loc.get("pdf_url"):
                    return loc["pdf_url"]
            if data.get("open_access", {}).get("oa_url"):
                oa_u = data["open_access"]["oa_url"]
                if oa_u and oa_u.lower().endswith(".pdf"):
                    return oa_u
    except Exception as e:
        print(f"OpenAlex OA: {e}", file=sys.stderr)
        
    # 3. Consultar directament la pàgina del DOI per scraping de metadades
    try:
        landing_url = f"https://doi.org/{doi}"
        req = Request(landing_url, headers=HEADERS)
        with urlopen(req, timeout=12) as resp:
            html = resp.read().decode("utf-8", errors="ignore")
        candidates = scrape_pdf_links_from_html(html, landing_url)
        if candidates:
            return candidates[0]
    except Exception as e:
        print(f"Landing page scrape: {e}", file=sys.stderr)
        
    return None

def download_pdf(pdf_url, target_path):
    """Descarrega el PDF amb curl, amb suport per seguir enllaços de visualització OJS, Dialnet i repositoris."""
    temp_target = target_path.with_suffix(".tmp")
    target_path.parent.mkdir(parents=True, exist_ok=True)
    try:
        cmd = [
            "curl", "-skL", "--connect-timeout", "4", "--max-time", "15",
            "-A", HEADERS["User-Agent"],
            "-o", str(temp_target),
            pdf_url
        ]
        subprocess.run(cmd, check=False)
        if temp_target.is_file():
            data = temp_target.read_bytes()
            if data.startswith(b"%PDF"):
                temp_target.replace(target_path)
                return True
                
            # Detectar si és un bloqueig per bot challenge (com Fastly / Cloudflare)
            html = data.decode("utf-8", errors="ignore")
            if "Client Challenge" in html or "_fs_ch_st" in html or "cf-browser-verification" in html:
                temp_target.unlink()
                return False
                
            # Si hem obtingut una pàgina HTML (com a Dialnet o visors OJS), analitzem els enllaços interns
            candidates = scrape_pdf_links_from_html(html, pdf_url)
            for cand in candidates:
                cmd2 = [
                    "curl", "-skL", "--connect-timeout", "4", "--max-time", "15",
                    "-A", HEADERS["User-Agent"],
                    "-o", str(temp_target),
                    cand
                ]
                subprocess.run(cmd2, check=False)
                if temp_target.is_file():
                    data2 = temp_target.read_bytes()
                    if data2.startswith(b"%PDF"):
                        temp_target.replace(target_path)
                        return True
                        
        if temp_target.is_file():
            temp_target.unlink()
    except Exception as e:
        print(f"Error descarregant el PDF: {e}", file=sys.stderr)
    return False

def key_exists_in_bib(key, bib_file):
    """Comprova si la clau ja existeix a biblioteca.bib."""
    if not bib_file.is_file():
        return False
    content = bib_file.read_text(encoding="utf-8", errors="ignore")
    return bool(re.search(rf'@[a-zA-Z]+\s*\{{\s*{re.escape(key)}\s*,', content))

def format_and_append_bibtex(raw_bib, citekey, pdf_path, bib_file):
    """Afegeix la citekey i el camp file = {...} a l'entrada BibTeX i la desa."""
    formatted = re.sub(r'^@([a-zA-Z]+)\s*\{[^,]+,', rf'@\1{{{citekey},', raw_bib.strip(), count=1)
    pdf_field = f"  file = {{{pdf_path}}},\n"
    
    last_brace_index = formatted.rfind('}')
    if last_brace_index != -1:
        entry_body = formatted[:last_brace_index].rstrip()
        if not entry_body.endswith(','):
            entry_body += ','
        formatted = f"{entry_body}\n{pdf_field}}}"
        
    bib_file.parent.mkdir(parents=True, exist_ok=True)
    with open(bib_file, "a", encoding="utf-8") as f:
        f.write(f"\n{formatted}\n")

def create_initial_note(citekey, title, author, year, notes_dir, abstract="", doi=""):
    """Crea una nota inicial en Markdown per a l'article si no existeix."""
    notes_dir.mkdir(parents=True, exist_ok=True)
    note_path = notes_dir / f"@{citekey}.md"
    if note_path.is_file():
        return
        
    author_clean = clean_latex(" and ".join(author) if isinstance(author, list) else str(author))
    abs_clean = re.sub(r'<[^>]+>', '', str(abstract)).strip() if abstract else ""

    lines = [
        "---",
        f'title: "{clean_latex(title)}"',
        f'author: "{author_clean}"',
        f'year: {year}',
        f'citekey: "@{citekey}"'
    ]
    if doi:
        lines.append(f'doi: "{doi}"')
    lines.extend([
        "tags: []",
        "---",
        "# Resum / Abstract",
        "",
        abs_clean,
        "",
        "# Idees clau",
        "",
        "* ",
        ""
    ])
    note_content = "\n".join(lines)
    note_path.write_text(note_content, encoding="utf-8")

def process_paper_by_doi(doi, direct_pdf=None, abstract=None):
    """Processa un article a partir del seu DOI canònic."""
    notify("Biblioteca", f"🔍 Processant article...\nDOI: {doi}")
    print(f"🔍 Obtenint metadades de Crossref per a: {doi}...")
    
    try:
        raw_bib = fetch_bibtex_from_doi(doi)
    except Exception as e:
        msg = f"❌ Error obtenint dades de Crossref per a {doi}: {e}"
        notify("Biblioteca", msg, "critical")
        print(msg, file=sys.stderr)
        return False
        
    author = extract_field("author", raw_bib)
    title = extract_field("title", raw_bib)
    year = extract_field("year", raw_bib)
    citekey = generate_citekey(author, title, year)
    
    raw_bib_abstract = extract_field("abstract", raw_bib)
    if raw_bib_abstract:
        raw_bib_abstract = re.sub(r'<[^>]+>', '', raw_bib_abstract).strip()
    final_abstract = abstract or raw_bib_abstract
    if not final_abstract:
        final_abstract = fetch_abstract_from_openalex(doi)
    
    if key_exists_in_bib(citekey, BIB_FILE):
        msg = f"ℹ️ L'article ja existeix a la biblioteca: @{citekey}"
        notify("Biblioteca", msg)
        print(msg)
        return True
        
    target_pdf = PDF_DIR / f"{citekey}.pdf"
    pdf_saved = False
    if target_pdf.is_file():
        pdf_saved = True
    else:
        print("📄 Cercant PDF en accés obert...")
        # 1. Enllaç directe si s'ha proporcionat (p. ex. Dialnet o OpenAlex oa_url)
        if direct_pdf:
            print(f"⬇️ Provant enllaç directe ({direct_pdf[:65]}...)...")
            pdf_saved = download_pdf(direct_pdf, target_pdf)
            
        # 2. Resolució i scraping directe de la pàgina web del DOI (com fa KBibTeX)
        if not pdf_saved:
            doi_url = f"https://doi.org/{doi}"
            print(f"⬇️ Provant resolució de pàgina DOI ({doi_url})...")
            pdf_saved = download_pdf(doi_url, target_pdf)
            
        # 3. Consulta a la base de dades Unpaywall
        if not pdf_saved:
            unpaywall_url = find_pdf_url(doi)
            if unpaywall_url:
                print(f"⬇️ Provant Unpaywall ({unpaywall_url[:65]}...)...")
                pdf_saved = download_pdf(unpaywall_url, target_pdf)
            
    format_and_append_bibtex(raw_bib, citekey, target_pdf, BIB_FILE)
    create_initial_note(citekey, title, author, year, NOTES_DIR, abstract=final_abstract, doi=doi)
    
    if pdf_saved:
        pdf_status = "📄 PDF desat"
    else:
        if not is_eduvpn_active():
            pdf_status = "⚠️ Sense PDF lliure (Connecta EduVPN UV)"
            print("\n💡 Avís EduVPN: L'article no disposa de PDF en accés obert.")
            print("   Si tens accés institucional a través de la Universitat de València:")
            print("   1. Connecta la VPN:  nmcli con up eduvpn")
            print("   2. Torna a intentar-ho o executa: add-paper --vpn <DOI>")
        else:
            pdf_status = "⚠️ Sense PDF (de pagament o no disponible a la subscripció)"

    short_title = clean_latex(title)
    if len(short_title) > 60:
        short_title = short_title[:57] + "..."
        
    notify(
        f"📚 Article afegit: @{citekey}",
        f"{short_title}\n{pdf_status} | 📝 Nota creada"
    )
    print(f"✅ Article afegit amb èxit: @{citekey}")
    print(f"   Títol: {short_title}")
    print(f"   Estat PDF: {pdf_status}")
    print(f"   Nota: ~/Documents/notes/@{citekey}.md")
    return True

def process_paper_input(raw_input, direct_pdf=None):
    """Processa qualsevol entrada: URL, DOI, Dialnet, cerca de text o dades estructurades."""
    raw_input = unquote(raw_input).strip()
    raw_input = re.sub(r'^(?:bibtex|bib):\/?\/?', '', raw_input, flags=re.IGNORECASE).strip()
    
    # Dades estructurades directes del navegador (marcador o extensió)
    if raw_input.startswith("data:"):
        data_json = raw_input[5:]
        try:
            meta = json.loads(data_json)
        except Exception as e:
            notify("Biblioteca", f"⚠️ Dades mal formades: {e}", "critical")
            print(f"⚠️ Dades mal formades: {e}", file=sys.stderr)
            sys.exit(1)
            
        title = meta.get("title", "")
        authors = meta.get("authors", [])
        year = meta.get("year", "")
        pdf_url = direct_pdf or meta.get("pdf_url", "")
        
        notify("Biblioteca", f"🔍 Processant article...\n{title[:50]}...")
        print(f"🔍 Processant dades estructurades: {title[:60]}...")
        
        oa_work = search_openalex(title)
        doi = None
        if oa_work:
            raw_doi = oa_work.get("doi")
            if raw_doi:
                doi = raw_doi.replace("https://doi.org/", "").strip()
            if not pdf_url and oa_work.get("open_access", {}).get("oa_url"):
                pdf_url = oa_work["open_access"]["oa_url"]
                
        raw_bib = None
        if doi:
            try:
                raw_bib = fetch_bibtex_from_doi(doi)
            except Exception:
                pass
                
        first_author = authors[0] if authors else "Desconegut"
        citekey = generate_citekey(first_author, title, year)
        
        if key_exists_in_bib(citekey, BIB_FILE):
            notify("Biblioteca", f"ℹ️ L'article ja existeix a la biblioteca:\n@{citekey}")
            print(f"ℹ️ L'article ja existeix a la biblioteca: @{citekey}")
            return
            
        target_pdf = PDF_DIR / f"{citekey}.pdf"
        pdf_saved = False
        if target_pdf.is_file():
            pdf_saved = True
        elif pdf_url:
            pdf_saved = download_pdf(pdf_url, target_pdf)
            
        if raw_bib:
            format_and_append_bibtex(raw_bib, citekey, target_pdf, BIB_FILE)
        else:
            bib_entry = build_bibtex_from_dict(citekey, meta, target_pdf)
            with open(BIB_FILE, "a", encoding="utf-8") as f:
                f.write(f"\n{bib_entry}\n")
                
        create_initial_note(citekey, title, authors, year, NOTES_DIR, abstract=meta.get("abstract", ""))
        pdf_status = "📄 PDF desat" if pdf_saved else "⚠️ Sense PDF automàtic"
        notify(f"📚 Article afegit: @{citekey}", f"{clean_latex(title)[:55]}...\n{pdf_status} | 📝 Nota creada")
        print(f"✅ Article afegit: @{citekey} ({pdf_status})")
        return

    # Comprovació Dialnet específica
    if "dialnet" in raw_input.lower() or "codigo=" in raw_input.lower():
        print("🔍 Detectat enllaç de Dialnet, resolent metadades...")
        doi, resolved_direct_pdf, dialnet_title, meta = resolve_dialnet(raw_input)
        final_direct_pdf = direct_pdf or resolved_direct_pdf
        if doi:
            print(f"✅ DOI trobat a Dialnet/OpenAlex: {doi}")
            process_paper_by_doi(doi, direct_pdf=final_direct_pdf, abstract=meta.get("abstract", ""))
            return
        elif meta.get("title"):
            first_author = meta.get("authors", ["Desconegut"])[0] if meta.get("authors") else "Desconegut"
            citekey = generate_citekey(first_author, meta["title"], meta.get("year", ""))
            target_pdf = PDF_DIR / f"{citekey}.pdf"
            pdf_saved = False
            if target_pdf.is_file():
                pdf_saved = True
            elif final_direct_pdf:
                pdf_saved = download_pdf(final_direct_pdf, target_pdf)
            bib_entry = build_bibtex_from_dict(citekey, meta, target_pdf)
            with open(BIB_FILE, "a", encoding="utf-8") as f:
                f.write(f"\n{bib_entry}\n")
            create_initial_note(citekey, meta["title"], meta.get("authors", []), meta.get("year", ""), NOTES_DIR, abstract=meta.get("abstract", ""))
            pdf_status = "📄 PDF desat" if pdf_saved else "⚠️ Sense PDF automàtic"
            notify(f"📚 Article Dialnet afegit: @{citekey}", f"{clean_latex(meta['title'])[:55]}...\n{pdf_status} | 📝 Nota creada")
            print(f"✅ Article Dialnet afegit: @{citekey} ({pdf_status})")
            return

    # Resolució general de DOI o arXiv
    doi, resolved_direct_pdf = resolve_doi_or_arxiv(raw_input)
    final_direct_pdf = direct_pdf or resolved_direct_pdf
    
    # Si no hem trobat DOI directe, intentem cercar el text a OpenAlex
    if not doi and not raw_input.startswith("http"):
        print(f"🔍 Cercant '{raw_input[:50]}' a OpenAlex...")
        oa_work = search_openalex(raw_input)
        if oa_work and oa_work.get("doi"):
            doi = oa_work["doi"].replace("https://doi.org/", "").strip()
            if not final_direct_pdf and oa_work.get("open_access", {}).get("oa_url"):
                final_direct_pdf = oa_work["open_access"]["oa_url"]
                
    if not doi:
        notify("Biblioteca", f"⚠️ No s'ha pogut reconèixer cap DOI ni a OpenAlex:\n{raw_input[:60]}...", "critical")
        print(f"⚠️ No s'ha pogut reconèixer cap DOI ni a OpenAlex per a: {raw_input}", file=sys.stderr)
        sys.exit(1)
        
    process_paper_by_doi(doi, direct_pdf=final_direct_pdf)

def interactive_search(initial_query=""):
    """Mode interactiu: cerca federada en paral·lel a OpenAlex, ERIC, Crossref i Dialnet amb deduplicació."""
    query = initial_query.strip()
    if not query:
        try:
            query = input("🔍 Introdueix termes de cerca (títol, paraules clau, autor): ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nOperació cancel·lada.")
            return
            
    if not query:
        print("Cerca buida. Eixint.")
        return

    print(f"\n🔍 Cercant en paral·lel a OpenAlex, ERIC, Crossref i Dialnet: \"{query}\"...")
    results = federated_search(query, limit_per_source=5)
    if not results:
        print("❌ No s'ha trobat cap article amb aquests termes.")
        return

    display_count = min(len(results), 10)
    print("\n" + "=" * 78)
    print(f"📚 Resultats federats per a: \"{query}\" ({len(results)} articles únics trobats)")
    print("=" * 78)
    for idx, item in enumerate(results[:display_count], 1):
        year_str = f"({item['year']}) " if item.get('year') else ""
        authors = item.get("authors", [])
        if len(authors) > 2:
            author_str = f"{authors[0]} et al."
        elif authors:
            author_str = ", ".join(authors)
        else:
            author_str = "Autor desconegut"
            
        sources_str = " | ".join(item.get("sources", []))
        oa_badge = "🟢 Accés Obert" if item.get("is_oa") else "🔒 Sense OA directe"
        doi_str = f"DOI: {item['doi']}" if item.get('doi') else (
            f"Dialnet: {item['dialnet_id']}" if item.get('dialnet_id') else (
                f"ERIC: {item['eric_id']}" if item.get('eric_id') else "Sense DOI registrat"
            )
        )
        
        print(f"[{idx}] [{sources_str}] {year_str}{author_str}")
        print(f"    Títol: {clean_latex(item['title'])}")
        print(f"    {doi_str} | {oa_badge}")
        print()
    print("[q] Cancel·lar i eixir")
    print("=" * 78)
    
    while True:
        try:
            choice = input(f"Selecciona un article [1-{display_count}] (o 'q' per eixir): ").strip().lower()
        except (KeyboardInterrupt, EOFError):
            print("\nCancel·lat.")
            return
            
        if choice in ("q", "quit", "exit", ""):
            print("Operació cancel·lada.")
            return
        if choice.isdigit() and 1 <= int(choice) <= display_count:
            selected = results[int(choice) - 1]
            break
        print(f"Opció no vàlida. Introdueix un número entre 1 i {display_count}.")

    print(f"\n🚀 Processant selecció: {clean_latex(selected['title'])[:60]}...")
    doi = selected.get("doi")
    direct_pdf = selected.get("oa_url")
    dialnet_id = selected.get("dialnet_id")
    eric_id = selected.get("eric_id")

    if doi:
        process_paper_by_doi(doi, direct_pdf=direct_pdf, abstract=selected.get("abstract", ""))
    elif dialnet_id:
        process_paper_input(f"https://dialnet.unirioja.es/servlet/articulo?codigo={dialnet_id}")
    elif eric_id and direct_pdf:
        meta = {
            "title": selected.get("title", ""),
            "authors": selected.get("authors", []),
            "year": selected.get("year", ""),
            "abstract": selected.get("abstract", ""),
            "pdf_url": direct_pdf
        }
        process_paper_input("data:" + json.dumps(meta))
    else:
        process_paper_input(selected["title"])

def print_help():
    """Mostra l'ajuda de la línia d'ordres."""
    print("""Ús: add-paper [OPCIONS] [DOI | ARXIV | URL | TÍTOL]

Afegeix articles a la biblioteca BibTeX (~/Documents/Biblioteca/biblioteca.bib),
descarrega el PDF automàticament a pdfs/ i en crea la nota Markdown a notes/@citekey.md.

Opcions:
  -s, --search [TERMES]   Cerca interactiva federada (OpenAlex, ERIC, Crossref, Dialnet)
  --vpn                   Connecta automàticament a EduVPN UV abans de la descàrrega
  -h, --help              Mostra aquesta ajuda

Exemples:
  add-paper 10.1016/j.compedu.2023.104845
  add-paper --vpn 10.1016/j.compedu.2023.104845
  add-paper https://arxiv.org/abs/2301.00001
  add-paper https://dialnet.unirioja.es/servlet/articulo?codigo=6327318
  add-paper -s "pensamiento computacional en primaria"
  add-paper               (llegeix de forma autònoma el portapapers Wayland/X11)
""")

def main():
    # Comprovar arguments
    args = sys.argv[1:]
    
    if any(a in ("-h", "--help") for a in args):
        print_help()
        sys.exit(0)

    if "--vpn" in args:
        args.remove("--vpn")
        if not is_eduvpn_active():
            connect_eduvpn()

    direct_pdf_arg = None
    if "--pdf-url" in args:
        idx = args.index("--pdf-url")
        if idx + 1 < len(args):
            direct_pdf_arg = args[idx + 1]
            args.pop(idx + 1)
            args.pop(idx)

    if args and args[0] in ("-s", "--search"):
        query = " ".join(args[1:]).strip()
        interactive_search(query)
        sys.exit(0)

    # 1. Obtenir text d'entrada (argument o portapapers)
    raw_input = " ".join(args).strip()
    if not raw_input:
        raw_input = get_clipboard_text()
        
    raw_input = unquote(raw_input).strip()
    if not raw_input:
        notify("Biblioteca", "⚠️ No s'ha trobat cap text, DOI o URL al portapapers", "critical")
        print("⚠️ No s'ha trobat cap text, DOI o URL com a argument ni al portapapers.", file=sys.stderr)
        print("Executa 'add-paper --help' o 'add-paper -s [termes]' per cercar interactivament.", file=sys.stderr)
        sys.exit(1)
        
    process_paper_input(raw_input, direct_pdf=direct_pdf_arg)

if __name__ == "__main__":
    main()
