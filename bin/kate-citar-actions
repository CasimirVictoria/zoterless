#!/usr/bin/env python3
"""
kate-citar-actions: Menú d'accions sobre la citació sota el cursor a Kate
Obre el PDF associat a ~/Documents/Biblioteca/pdfs/ (o camp file) a Okular
i la nota bibliogràfica associada (@citekey.md) de ~/Documents/notes/ a Kate.
"""

import re
import sys
import subprocess
from pathlib import Path
from PyQt5.QtWidgets import (
    QApplication, QDialog, QVBoxLayout, QLabel, QPushButton, QLineEdit, QListWidget
)
from PyQt5.QtCore import Qt
from PyQt5.QtGui import QFont

BIB_FILE = Path.home() / "Documents/Biblioteca/biblioteca.bib"
PDF_DIR = Path.home() / "Documents/Biblioteca/pdfs"
NOTES_DIR = Path.home() / "Documents/notes"

def extract_citekey_from_args():
    """Extreu la clau de citació del text passat per arguments o selecció."""
    text = " ".join(sys.argv[1:]).strip()
    if not text:
        return None
        
    matches = re.findall(r'@([a-zA-Z0-9_\-]+)', text)
    if matches:
        return matches[-1]
        
    for w in text.split():
        w_clean = re.sub(r'[^a-zA-Z0-9_\-]', '', w)
        if w_clean:
            return w_clean
            
    return None

def clean_pdf_path(raw_field):
    """
    Extreu una ruta vàlida de fitxer PDF del camp file de BibTeX.
    Maneja formats tipus:
    - /ruta/fitxer.pdf
    - /ruta/fitxer.pdf:application/pdf
    - Títol:/ruta/fitxer.pdf:application/pdf
    - Rutes múltiples separades per ';'
    """
    if not raw_field:
        return None

    # Zotero separa múltiples fitxers amb punt i coma
    entries = raw_field.split(';')
    for entry in entries:
        parts = entry.split(':')
        for part in parts:
            part = part.strip()
            if part.lower().endswith('.pdf'):
                candidate = Path(part)
                if candidate.is_file():
                    return candidate
                if (PDF_DIR / candidate.name).is_file():
                    return PDF_DIR / candidate.name
                    
    # Si és una ruta directa sense ':'
    candidate = Path(raw_field.strip())
    if candidate.is_file() and candidate.suffix.lower() == '.pdf':
        return candidate
    if (PDF_DIR / candidate.name).is_file() and candidate.suffix.lower() == '.pdf':
        return PDF_DIR / candidate.name

    return None

def extract_field(name, text):
    """Extreu el valor d'un camp BibTeX tenint en compte claus niades o cometes."""
    m = re.search(rf'\b{name}\s*=\s*', text, re.IGNORECASE)
    if not m:
        return ""
    start = m.end()
    if start >= len(text):
        return ""
    if text[start] == '{':
        depth = 0
        val = []
        for ch in text[start:]:
            if ch == '{':
                depth += 1
                if depth > 1:
                    val.append(ch)
            elif ch == '}':
                depth -= 1
                if depth == 0:
                    break
                val.append(ch)
            else:
                val.append(ch)
        return "".join(val)
    elif text[start] == '"':
        m_quote = re.search(r'^"([^"]*)"', text[start:])
        return m_quote.group(1) if m_quote else ""
    else:
        m_bare = re.match(r'^([^,\n]+)', text[start:])
        return m_bare.group(1).strip() if m_bare else ""

def get_bib_dict():
    """Llegeix biblioteca.bib i crea un diccionari clau -> {pdf, raw}."""
    if not BIB_FILE.is_file():
        return {}

    content = BIB_FILE.read_text(encoding="utf-8", errors="ignore")
    raw_entries = re.split(r'(?:\r?\n|^)@', content)
    bib_dict = {}
    for raw in raw_entries:
        if not raw.strip():
            continue
        m = re.match(r'^([a-zA-Z]+)\s*\{\s*([^,]+),', raw.strip())
        if not m:
            continue
        key = m.group(2).strip()
        
        file_val = extract_field("file", raw)
        pdf_path = clean_pdf_path(file_val) if file_val else None
                
        bib_dict[key] = {
            "pdf": pdf_path,
            "raw": raw
        }
    return bib_dict

def find_pdf_for_key(key, bib_dict):
    """Retorna el PDF associat al camp file del .bib o cerca per nom a PDF_DIR."""
    if key in bib_dict and bib_dict[key]["pdf"]:
        return bib_dict[key]["pdf"]
        
    if not PDF_DIR.is_dir():
        return None
        
    direct = PDF_DIR / f"{key}.pdf"
    if direct.is_file():
        return direct
        
    key_clean = key.lower().replace('_', '').replace('-', '')
    for f in PDF_DIR.glob("*.pdf"):
        fname_clean = f.name.lower().replace('_', '').replace('-', '')
        if key_clean in fname_clean or key.lower() in f.name.lower():
            return f
    return None

def find_note_for_key(key):
    """Cerca la nota bibliogràfica associada a la clau a ~/Documents/notes/."""
    if not NOTES_DIR.is_dir():
        return None
        
    candidates = [
        NOTES_DIR / f"@{key}.md",
        NOTES_DIR / f"{key}.md",
    ]
    for c in candidates:
        if c.is_file():
            return c
            
    key_clean = key.lower()
    for f in NOTES_DIR.glob("*.md"):
        if f.stem.lower() in [f"@{key_clean}", key_clean]:
            return f
            
    return None

def launch_file(filepath):
    """Obre un fitxer de manera desacoblada del procés pare."""
    path_str = str(filepath.resolve())
    if filepath.suffix.lower() == '.pdf':
        cmd = ["okular", path_str]
    elif filepath.suffix.lower() in ['.org', '.md', '.qmd', '.txt']:
        cmd = ["kate", path_str]
    else:
        cmd = ["xdg-open", path_str]
        
    subprocess.Popen(
        cmd,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        stdin=subprocess.DEVNULL,
        start_new_session=True
    )

class ActionDialog(QDialog):
    def __init__(self, key, pdf_path, note_path):
        super().__init__()
        self.key = key
        self.pdf_path = pdf_path
        self.note_path = note_path
        self.init_ui()
        
    def init_ui(self):
        self.setWindowTitle(f"📑 Accions sobre: @{self.key}")
        self.resize(580, 240)
        self.setAttribute(Qt.WA_DeleteOnClose)
        
        layout = QVBoxLayout(self)
        layout.setContentsMargins(15, 15, 15, 15)
        layout.setSpacing(10)
        
        font = QFont()
        font.setPointSize(10)
        self.setFont(font)
        
        title_label = QLabel(f"<b>Referència:</b> <code style='color:#1a73e8; font-size:12pt;'>@{self.key}</code>", self)
        layout.addWidget(title_label)
        
        # Botó 1: Obrir PDF
        if self.pdf_path:
            pdf_text = f"📄 Obrir PDF ({self.pdf_path.name})"
        else:
            pdf_text = "📄 PDF: No trobat"
        self.btn_pdf = QPushButton(pdf_text, self)
        self.btn_pdf.setEnabled(self.pdf_path is not None)
        self.btn_pdf.clicked.connect(self.open_pdf)
        layout.addWidget(self.btn_pdf)
        
        # Botó 2: Obrir Nota bibliogràfica
        if self.note_path:
            note_text = f"📝 Obrir Nota ({self.note_path.name})"
        else:
            note_text = f"📝 Nota: No trobada (@{self.key}.md a notes/)"
        self.btn_note = QPushButton(note_text, self)
        self.btn_note.setEnabled(self.note_path is not None)
        self.btn_note.clicked.connect(self.open_note)
        layout.addWidget(self.btn_note)
        
        # Botó Tancar
        btn_cancel = QPushButton("Tancar (Esc)", self)
        btn_cancel.clicked.connect(self.reject)
        layout.addWidget(btn_cancel)
        
        if self.pdf_path:
            self.btn_pdf.setFocus()
        elif self.note_path:
            self.btn_note.setFocus()
            
    def open_pdf(self):
        if self.pdf_path:
            launch_file(self.pdf_path)
            self.accept()
            
    def open_note(self):
        if self.note_path:
            launch_file(self.note_path)
            self.accept()

class KeySelectDialog(QDialog):
    def __init__(self, all_keys):
        super().__init__()
        self.all_keys = all_keys
        self.selected_key = None
        self.init_ui()
        
    def init_ui(self):
        self.setWindowTitle("🔍 Tria una referència per obrir PDF o Nota")
        self.resize(650, 420)
        self.setAttribute(Qt.WA_DeleteOnClose)
        
        layout = QVBoxLayout(self)
        self.search_input = QLineEdit(self)
        self.search_input.setPlaceholderText("🔍 Cerca clau de citació...")
        self.search_input.textChanged.connect(self.filter_keys)
        layout.addWidget(self.search_input)
        
        self.list_widget = QListWidget(self)
        self.list_widget.itemDoubleClicked.connect(self.accept_selection)
        layout.addWidget(self.list_widget)
        
        self.populate(self.all_keys)
        self.search_input.setFocus()
        
    def populate(self, keys):
        self.list_widget.clear()
        for k in keys:
            self.list_widget.addItem(k)
        if self.list_widget.count() > 0:
            self.list_widget.setCurrentRow(0)
            
    def filter_keys(self, text):
        q = text.strip().lower()
        filtered = [k for k in self.all_keys if q in k.lower()]
        self.populate(filtered)
        
    def keyPressEvent(self, event):
        if event.key() in (Qt.Key_Return, Qt.Key_Enter):
            self.accept_selection()
        elif event.key() == Qt.Key_Escape:
            self.reject()
        else:
            super().keyPressEvent(event)
            
    def accept_selection(self):
        item = self.list_widget.currentItem()
        if item:
            self.selected_key = item.text()
            self.accept()
        else:
            self.reject()

def main():
    if not BIB_FILE.is_file():
        sys.stderr.write(f"No s'ha trobat el fitxer {BIB_FILE}\n")
        sys.exit(1)

    key = extract_citekey_from_args()
    bib_dict = get_bib_dict()
    if not bib_dict:
        sys.stderr.write("No s'han trobat entrades al fitxer BibTeX\n")
        sys.exit(1)

    app = QApplication(sys.argv)
    
    if not key:
        sel_dialog = KeySelectDialog(sorted(list(bib_dict.keys())))
        if sel_dialog.exec_() == QDialog.Accepted and sel_dialog.selected_key:
            key = sel_dialog.selected_key
        else:
            sys.exit(0)
            
    pdf_path = find_pdf_for_key(key, bib_dict)
    note_path = find_note_for_key(key)
    
    dialog = ActionDialog(key, pdf_path, note_path)
    dialog.exec_()

if __name__ == "__main__":
    main()
