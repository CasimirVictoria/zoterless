#!/usr/bin/env python3
"""
kate-citar: Cercador ràpid de referències BibTeX natiu per a Kate a Wayland / KDE Plasma
Suporta PyQt6 (natiu Plasma 6) amb fallback transparent a PyQt5.
"""

import re
import sys
from pathlib import Path

# --- Suport PyQt6 amb fallback transparent a PyQt5 ---
try:
    from PyQt6.QtWidgets import (
        QApplication, QDialog, QVBoxLayout, QLineEdit, QListWidget, QListWidgetItem
    )
    from PyQt6.QtCore import Qt
    from PyQt6.QtGui import QFont
    QT_VERSION = 6
    USER_ROLE = Qt.ItemDataRole.UserRole
    DELETE_ON_CLOSE = Qt.WidgetAttribute.WA_DeleteOnClose
    KEY_RETURN = Qt.Key.Key_Return
    KEY_ENTER = Qt.Key.Key_Enter
    KEY_DOWN = Qt.Key.Key_Down
    KEY_UP = Qt.Key.Key_Up
    KEY_ESCAPE = Qt.Key.Key_Escape
    DIALOG_ACCEPTED = QDialog.DialogCode.Accepted
except ImportError:
    from PyQt5.QtWidgets import (
        QApplication, QDialog, QVBoxLayout, QLineEdit, QListWidget, QListWidgetItem
    )
    from PyQt5.QtCore import Qt
    from PyQt5.QtGui import QFont
    QT_VERSION = 5
    USER_ROLE = Qt.UserRole
    DELETE_ON_CLOSE = Qt.WA_DeleteOnClose
    KEY_RETURN = Qt.Key_Return
    KEY_ENTER = Qt.Key_Enter
    KEY_DOWN = Qt.Key_Down
    KEY_UP = Qt.Key_Up
    KEY_ESCAPE = Qt.Key_Escape
    DIALOG_ACCEPTED = QDialog.Accepted

BIB_FILE = Path.home() / "Documents/Biblioteca/biblioteca.bib"

def clean_latex(text):
    """Neteja comandos LaTeX com {\\'e}, \\'{e}, etc."""
    if not text:
        return ""
    text = re.sub(r"\\['`^\"~]\{?([a-zA-Z])\}?", r"\1", text)
    text = re.sub(r'[\{\}\\]', '', text)
    text = text.replace('\n', ' ')
    return re.sub(r'\s+', ' ', text).strip()

def extract_field(name, text):
    """Extreu el valor d'un camp BibTeX tenint en compte claus niades o cometes."""
    m = re.search(rf'\b{name}\s*=\s*', text, re.IGNORECASE)
    if not m:
        return ""
    start = m.end()
    if start >= len(text):
        return ""
    if text[start] == '{':
        depth = 0
        val = []
        for ch in text[start:]:
            if ch == '{':
                depth += 1
                if depth > 1:
                    val.append(ch)
            elif ch == '}':
                depth -= 1
                if depth == 0:
                    break
                val.append(ch)
            else:
                val.append(ch)
        return "".join(val)
    elif text[start] == '"':
        m_quote = re.search(r'^"([^"]*)"', text[start:])
        return m_quote.group(1) if m_quote else ""
    else:
        m_bare = re.match(r'^([^,\n]+)', text[start:])
        return m_bare.group(1).strip() if m_bare else ""

def parse_bibtex(bib_path):
    """Parsejador lleuger i robust de BibTeX sense dependències externes."""
    entries = []
    with open(bib_path, "r", encoding="utf-8", errors="ignore") as f:
        content = f.read()

    raw_entries = re.split(r'(?:\r?\n|^)@', content)
    for raw in raw_entries:
        if not raw.strip():
            continue
        
        match_header = re.match(r'^([a-zA-Z]+)\s*\{\s*([^,]+),', raw.strip())
        if not match_header:
            continue
            
        entry_type = match_header.group(1).lower()
        cite_key = match_header.group(2).strip()
        
        if entry_type in ["comment", "string", "preamble"]:
            continue

        author = extract_field("author", raw) or "Desconegut"
        title = extract_field("title", raw) or "Sense títol"
        year = extract_field("year", raw) or "s.d."
        journal = extract_field("journal", raw) or extract_field("booktitle", raw) or ""
        
        author_clean = clean_latex(author).replace(' and ', ', ')
        title_clean = clean_latex(title)
        
        author_short = author_clean.split(',')[0].strip()
        if ',' in author_clean or 'et al' in author_clean:
            if not author_short.endswith('et al.'):
                author_short += " et al."
            
        display_line = f"{author_short:<25} ({year})  —  {title_clean}"
        if journal:
            journal_clean = clean_latex(journal)
            display_line += f"  [{journal_clean}]"
            
        search_text = f"{author_clean} {year} {title_clean} {journal} {cite_key}".lower()
            
        entries.append({
            "key": cite_key,
            "display": display_line,
            "search": search_text
        })
        
    return entries

class CitarDialog(QDialog):
    def __init__(self, entries):
        super().__init__()
        self.entries = entries
        self.selected_key = None
        self.init_ui()
        
    def init_ui(self):
        self.setWindowTitle("📚 Citar BibTeX — Kate")
        self.resize(920, 520)
        self.setAttribute(DELETE_ON_CLOSE)
        
        layout = QVBoxLayout(self)
        layout.setContentsMargins(12, 12, 12, 12)
        layout.setSpacing(10)
        
        self.search_input = QLineEdit(self)
        self.search_input.setPlaceholderText("🔍 Cerca per autor, any, títol o paraules clau... (Esc per cancel·lar)")
        self.search_input.setStyleSheet("""
            QLineEdit {
                padding: 8px 12px;
                border: 1px solid #cbd5e1;
                border-radius: 6px;
                font-size: 13px;
                background-color: #ffffff;
                color: #0f172a;
            }
            QLineEdit:focus {
                border: 1px solid #2563eb;
            }
        """)
        self.search_input.textChanged.connect(self.filter_entries)
        layout.addWidget(self.search_input)
        
        self.list_widget = QListWidget(self)
        self.list_widget.setStyleSheet("""
            QListWidget {
                border: 1px solid #cbd5e1;
                border-radius: 6px;
                padding: 6px;
                font-size: 12.5px;
                background-color: #ffffff;
                color: #0f172a;
            }
            QListWidget::item {
                padding: 6px 8px;
                border-radius: 4px;
            }
            QListWidget::item:selected {
                background-color: #2563eb;
                color: #ffffff;
            }
            QListWidget::item:hover {
                background-color: #f1f5f9;
            }
            QListWidget::item:selected:hover {
                background-color: #1d4ed8;
            }
        """)
        self.list_widget.itemDoubleClicked.connect(self.accept_selection)
        layout.addWidget(self.list_widget)
        
        self.populate_list(self.entries)
        self.search_input.setFocus()
        
    def populate_list(self, entries):
        self.list_widget.clear()
        for e in entries:
            item = QListWidgetItem(e["display"])
            item.setData(USER_ROLE, e["key"])
            self.list_widget.addItem(item)
        if self.list_widget.count() > 0:
            self.list_widget.setCurrentRow(0)
            
    def filter_entries(self, text):
        query_words = text.strip().lower().split()
        if not query_words:
            self.populate_list(self.entries)
            return
            
        filtered = []
        for e in self.entries:
            if all(word in e["search"] for word in query_words):
                filtered.append(e)
        self.populate_list(filtered)
        
    def keyPressEvent(self, event):
        key = event.key()
        if key in (KEY_RETURN, KEY_ENTER):
            self.accept_selection()
        elif key == KEY_DOWN:
            current = self.list_widget.currentRow()
            if current < self.list_widget.count() - 1:
                self.list_widget.setCurrentRow(current + 1)
        elif key == KEY_UP:
            current = self.list_widget.currentRow()
            if current > 0:
                self.list_widget.setCurrentRow(current - 1)
        elif key == KEY_ESCAPE:
            self.reject()
        else:
            super().keyPressEvent(event)
            
    def accept_selection(self):
        current_item = self.list_widget.currentItem()
        if current_item:
            self.selected_key = current_item.data(USER_ROLE)
            self.accept()
        else:
            self.reject()

def main():
    if not BIB_FILE.is_file():
        sys.stderr.write(f"No s'ha trobat el fitxer {BIB_FILE}\n")
        sys.exit(1)
        
    entries = parse_bibtex(BIB_FILE)
    if not entries:
        sys.stderr.write("No s'han trobat entrades al fitxer BibTeX\n")
        sys.exit(1)
        
    app = QApplication(sys.argv)
    dialog = CitarDialog(entries)
    exec_func = getattr(dialog, "exec", getattr(dialog, "exec_", None))
    if exec_func() == DIALOG_ACCEPTED and dialog.selected_key:
        sys.stdout.write(f"@{dialog.selected_key}")

if __name__ == "__main__":
    main()
