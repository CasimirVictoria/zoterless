#!/usr/bin/env python3
"""
zoterless-capture-paper: Captura automàticament l'article científic o PDF visible a la pantalla activa.
Optimitzat per a Falkon, Firefox, Okular i qualsevol visor d'escriptori a KDE Plasma 6.
"""

import os
import re
import subprocess
import sys
import time

def notify(title, message, urgency="normal"):
    try:
        subprocess.run(
            ["notify-send", "-a", "Zoterless", "-u", urgency, "-i", "accessories-dictionary", title, message],
            check=False
        )
    except Exception:
        pass

def get_target():
    # 1. Comprovar si hi ha text seleccionat al ratolí (Wayland primary selection)
    try:
        res = subprocess.run(["wl-paste", "--primary", "--no-newline"], capture_output=True, text=True, timeout=1)
        sel = res.stdout.strip()
        # Si és un DOI o una URL acadèmica/PDF, prioritat màxima
        if sel:
            if re.search(r'\b10\.\d{4,9}/[^\s"<>]+', sel):
                return sel
            if sel.startswith("http://") or sel.startswith("https://") or sel.startswith("file://"):
                return sel
    except Exception:
        pass

    # 2. Comprovar finestra activa amb KWin
    is_browser = True
    try:
        win_info = subprocess.run(["qdbus6", "org.kde.KWin", "/KWin", "queryWindowInfo"], capture_output=True, text=True, timeout=1).stdout.lower()
        is_browser = any(b in win_info for b in ["falkon", "firefox", "chromium", "chrome", "brave", "vivaldi", "librewolf", "zen"])
    except Exception:
        pass

    # 3. Demanar URL al navegador actiu mitjançant ydotool (Ctrl+L -> Ctrl+C -> Esc)
    if is_browser:
        try:
            # ydotool: KEY_LEFTCTRL=29, KEY_L=38, KEY_C=46, KEY_ESC=1
            subprocess.run(["ydotool", "key", "29:1", "38:1", "38:0", "29:0"], timeout=1)
            time.sleep(0.08)
            subprocess.run(["ydotool", "key", "29:1", "46:1", "46:0", "29:0"], timeout=1)
            time.sleep(0.08)
            subprocess.run(["ydotool", "key", "1:1", "1:0"], timeout=1)
            time.sleep(0.05)

            new_clip = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True, timeout=1).stdout.strip()
            if new_clip and (new_clip.startswith("http://") or new_clip.startswith("https://") or new_clip.startswith("file://") or re.search(r'\b10\.\d{4,9}/', new_clip)):
                return new_clip
        except Exception:
            pass

    # 4. Fallback al portapapers general (wl-paste)
    try:
        clip = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True, timeout=1).stdout.strip()
        if clip:
            return clip
    except Exception:
        pass

    return None

def main():
    target = get_target()
    if not target:
        notify("Zoterless: Capturar Article", "⚠️ No s'ha trobat cap URL ni DOI a la finestra activa ni al portapapers.", "critical")
        sys.exit(1)

    notify("Zoterless: Capturar Article", f"🔍 Processant article o PDF...\n{target[:60]}")
    cmd = ["add-paper", target]
    subprocess.run(cmd)

if __name__ == "__main__":
    main()
